function statIdentity(value) {
  return `${value.dev}:${value.ino}:${value.mode}:${value.size}:${value.mtimeNs}:${value.ctimeNs}`;
}
function movableStatIdentity(value) {
  return `${value.dev}:${value.ino}:${value.mode}:${value.size}`;
