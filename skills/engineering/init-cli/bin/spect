  validateSchemaName(metadata.schema, projectRoot);
  const parseResult = ChangeMetadataSchema.safeParse(metadata);
  if (!parseResult.success) {
    throw new ChangeMetadataError(
      `\u65E0\u6548\u7684\u5143\u6570\u636E\uFF1A${parseResult.error.message}`,
      metaPath
    );
  }
  const content = yaml.stringify(parseResult.data);
  try {
    fs6.writeFileSync(metaPath, content, "utf-8");
  } catch (err) {
    const ioError = err instanceof Error ? err : new Error(String(err));
    throw new ChangeMetadataError(
      `\u5199\u5165\u5143\u6570\u636E\u5931\u8D25\uFF1A${ioError.message}`,
      metaPath,
      ioError
    );
  }
}
function readChangeMetadata(changeDir, projectRoot) {
  const metaPath = path7.join(changeDir, METADATA_FILENAME);
  if (!fs6.existsSync(metaPath)) {
    return null;
  }
  let content;
  try {
    content = fs6.readFileSync(metaPath, "utf-8");
  } catch (err) {
    const ioError = err instanceof Error ? err : new Error(String(err));
    throw new ChangeMetadataError(
      `\u8BFB\u53D6\u5143\u6570\u636E\u5931\u8D25\uFF1A${ioError.message}`,
      metaPath,
      ioError
    );
  }
