function buildNextSteps(input) {
  const readyArtifact = input.artifactStatuses.find((artifact) => artifact.status === "ready");
  const steps = [];
  const storeFlag = input.storeId ? ` --store ${input.storeId}` : "";
  if (readyArtifact) {
    steps.push(
      `\u8FD0\u884C spect instructions ${readyArtifact.id} --change "${input.changeName}"${storeFlag} --json\uFF0C\u7136\u540E\u518D\u7F16\u5199\u8BE5\u5236\u54C1\u3002`
    );
  } else if (input.allArtifactsComplete) {
    steps.push(
      `\u6240\u6709\u89C4\u5212\u5236\u54C1\u5747\u5DF2\u5B8C\u6210\u3002\u8FD0\u884C spect instructions implement --change "${input.changeName}"${storeFlag} --json \u4EE5\u68C0\u67E5\u5B9E\u73B0\u8FDB\u5EA6\u3002`
    );
  }
  return steps;
}
