var DEFAULT_SCHEMA2 = "spec-driven";
function validateChangeName(name) {
  if (!name) {
    return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u4E3A\u7A7A" };
  }
  if (name.length > 200) {
    return { valid: false, error: "Change name is too long (200 characters max)" };
  }
  if (!isKebabId(name)) {
    if (/[A-Z]/.test(name)) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u5FC5\u987B\u4E3A\u5C0F\u5199\uFF08\u4F7F\u7528 kebab-case\uFF09" };
    }
    if (/\s/.test(name)) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u5305\u542B\u7A7A\u683C\uFF08\u6539\u7528\u8FDE\u5B57\u7B26\uFF09" };
    }
    if (/_/.test(name)) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u5305\u542B\u4E0B\u5212\u7EBF\uFF08\u6539\u7528\u8FDE\u5B57\u7B26\uFF09" };
    }
    if (name.startsWith("-")) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u4EE5\u8FDE\u5B57\u7B26\u5F00\u5934" };
    }
    if (name.endsWith("-")) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u4EE5\u8FDE\u5B57\u7B26\u7ED3\u5C3E" };
    }
    if (/--/.test(name)) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u5305\u542B\u8FDE\u7EED\u8FDE\u5B57\u7B26" };
    }
    if (/[^a-z0-9-]/.test(name)) {
      return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u53EA\u80FD\u5305\u542B\u5C0F\u5199\u5B57\u6BCD\u3001\u6570\u5B57\u548C\u8FDE\u5B57\u7B26" };
    }
    return { valid: false, error: "\u53D8\u66F4\u540D\u79F0\u5FC5\u987B\u9075\u5FAA kebab-case \u7EA6\u5B9A\uFF08\u4F8B\u5982 add-auth\u3001refactor-db\uFF09" };
  }
  return { valid: true };
}
async function createChange(projectRoot, name, options = {}) {
  const validation = validateChangeName(name);
  if (!validation.valid) {
    throw new Error(validation.error);
  }
  const defaultSchema = options.defaultSchema ?? DEFAULT_SCHEMA2;
  let schemaName;
  if (options.schema) {
    schemaName = options.schema;
  } else {
    try {
      const config2 = readProjectConfig(projectRoot);
      schemaName = config2?.schema ?? defaultSchema;
    } catch {
      schemaName = defaultSchema;
    }
  }
  validateSchemaName(schemaName, projectRoot);
  const changeDir = import_path18.default.join(options.changesDir ?? import_path18.default.join(projectRoot, "openspec", "changes"), name);
  if (await FileSystemUtils.directoryExists(changeDir)) {
    throw new Error(`Change '${name}' \u5DF2\u5B58\u5728\uFF1A${changeDir}`);
  }
  const openspecDir = import_path18.default.join(projectRoot, "openspec");
  await FileSystemUtils.createDirectory(changeDir);
  await FileSystemUtils.createDirectory(import_path18.default.join(openspecDir, "specs"));
  await FileSystemUtils.createDirectory(import_path18.default.join(openspecDir, "changes", "archive"));
  const configPath = import_path18.default.join(openspecDir, "config.yaml");
  if (!await FileSystemUtils.fileExists(configPath)) {
    await FileSystemUtils.writeFile(configPath, `schema: ${defaultSchema}
`);
  }
  writeChangeMetadata(changeDir, {
    schema: schemaName,
    created: formatLocalDate(),
    ...options.metadata
  }, projectRoot);
  return { schema: schemaName, changeDir };
}

// src/commands/workflow/new-change.ts
function assertRemovedOptionsAbsent(options) {
  if (options.initiative !== void 0) {
    throw new RootSelectionError(
      "--initiative is no longer supported. Normal changes no longer attach to initiatives; --store <id> selects the OpenSpec root.",
      "initiative_option_removed",
      { target: "change.options" }
    );
  }
  if (options.areas !== void 0) {
    throw new RootSelectionError(
      "--areas is no longer supported. Workspace affected areas are not part of the normal OpenSpec root path.",
      "areas_option_removed",
      { target: "change.options" }
    );
  }
}
function printCreatedChangeHuman(payload, root) {
  const location = !isStoreSelectedRoot(root) && root.path === process.cwd() ? formatChangeLocation(toPlanningHome(root), payload.change.id) : payload.change.path;
  console.log(`\u5DF2\u521B\u5EFA\u53D8\u66F4 '${payload.change.id}'\uFF0C\u4F4D\u7F6E ${location}/`);
  console.log(`Schema\uFF1A${payload.change.schema}`);
  console.log(`\u4E0B\u4E00\u6B65\uFF1A${withStoreFlag(root, `spect status --change ${payload.change.id}`)}`);
}
async function newChangeCommand(name, options) {
  const spinner = options.json ? void 0 : ora();
  try {
    if (!name) {
      throw new Error("\u7F3A\u5C11\u5FC5\u9700\u53C2\u6570 <name>");
    }
    const validation = validateChangeName(name);
    if (!validation.valid) {
      throw new Error(validation.error);
    }
    assertRemovedOptionsAbsent(options);
    const root = await resolveRootForCommand(options, {
      json: options.json,
      failurePayload: { change: null }
    });
    if (!root) {
      return;
    }
    const projectRoot = root.path;
    if (options.schema) {
      validateSchemaExists(options.schema, projectRoot);
    }
    const resolvedSchema = options.schema ?? root.defaultSchema;
    if (spinner) {
      spinner.start(`\u6B63\u5728\u521B\u5EFA\u53D8\u66F4 '${name}'\uFF08schema '${resolvedSchema}'\uFF09...`);
    }
    const result = await createChange(projectRoot, name, {
      schema: options.schema,
      defaultSchema: root.defaultSchema,
      changesDir: root.changesDir,
      metadata: {
        ...options.goal ? { goal: options.goal } : {}
      }
    });
    if (options.description) {
      const { promises: fs23 } = await import("fs");
      const readmePath = import_path19.default.join(result.changeDir, "README.md");
      await fs23.writeFile(readmePath, `# ${name}

${options.description}
`, "utf-8");
    }
    const payload = {
      change: {
        id: name,
        path: result.changeDir,
        metadataPath: import_path19.default.join(result.changeDir, ".openspec.yaml"),
        schema: result.schema
      },
      root: toRootOutput(root)
    };
    if (options.json) {
      printJson2(payload);
      return;
    }
    spinner?.stop();
    printCreatedChangeHuman(payload, root);
  } catch (error52) {
    spinner?.stop();
    if (options.json) {
      printJson2({
        change: null,
        status: [statusFromError(error52)]
      });
      process.exitCode = 1;
      return;
    }
    throw error52;
  }
}

