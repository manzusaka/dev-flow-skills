function getPackageSchemasDir() {
  if (typeof import_meta.url !== "string") {
    return path5.join(path5.sep, ".spect-bundle", "schemas");
  }
  const currentFile = (0, import_node_url.fileURLToPath)(import_meta.url);
  return path5.join(path5.dirname(currentFile), "..", "..", "..", "schemas");
}
function getUserSchemasDir() {
  return path5.join(getGlobalDataDir(), "schemas");
}
function getProjectSchemasDir(projectRoot) {
  return path5.join(projectRoot, "openspec", "schemas");
}
function isOwnedForkTempDir(name) {
  return name.startsWith(".fork-staging-") || name.includes(".fork-backup-");
}
function isSchemaDir(parentDir, entry) {
  if (isOwnedForkTempDir(entry.name)) {
    return false;
  }
  if (entry.isDirectory()) {
    return true;
  }
  if (entry.isSymbolicLink()) {
    try {
      return fs5.statSync(path5.join(parentDir, entry.name)).isDirectory();
    } catch {
      return false;
    }
  }
  return false;
}
function getSchemaCandidateDir(schemasDir, name) {
  const schemaDir = path5.join(schemasDir, name);
  const schemaPath = path5.join(schemaDir, "schema.yaml");
  if (!fs5.existsSync(schemaPath)) {
    return null;
  }
  try {
    FileSystemUtils.assertPathWithin(schemaDir, schemaPath);
    return schemaDir;
  } catch {
    return null;
  }
}
function getSchemaDir(name, projectRoot) {
  if (name.length === 0 || name === "." || name === ".." || /[\\/]/u.test(name) || /^[A-Za-z]:/u.test(name) || path5.posix.isAbsolute(name) || path5.win32.isAbsolute(name)) {
    return null;
  }
  if (projectRoot) {
    const projectDir = getSchemaCandidateDir(getProjectSchemasDir(projectRoot), name);
    if (projectDir) {
      return projectDir;
    }
    if (name === DEFAULT_OPENSPEC_SCHEMA) {
      const flatDir = getProjectSchemasDir(projectRoot);
      if (fs5.existsSync(path5.join(flatDir, "schema.yaml"))) {
        return flatDir;
      }
    }
  }
  const userDir = getSchemaCandidateDir(getUserSchemasDir(), name);
  if (userDir) {
    return userDir;
  }
  const packageDir = getSchemaCandidateDir(getPackageSchemasDir(), name);
  if (packageDir) {
    return packageDir;
  }
  return null;
}
function resolveSchema(name, projectRoot) {
  const normalizedName = name.replace(/\.ya?ml$/, "");
  const schemaDir = getSchemaDir(normalizedName, projectRoot);
  if (!schemaDir) {
    const availableSchemas = listSchemas(projectRoot);
    throw new Error(
      `Schema '${normalizedName}' not found. Available schemas: ${availableSchemas.join(", ")}`
    );
  }
  const schemaPath = path5.join(schemaDir, "schema.yaml");
  let content;
  try {
    content = fs5.readFileSync(schemaPath, "utf-8");
  } catch (err) {
    const ioError = err instanceof Error ? err : new Error(String(err));
    throw new SchemaLoadError(
      `\u8BFB\u53D6 '${schemaPath}' \u5904\u7684 schema \u5931\u8D25\uFF1A${ioError.message}`,
      schemaPath,
      ioError
    );
  }
  try {
    return parseSchema(content);
  } catch (err) {
    if (err instanceof SchemaValidationError) {
      throw new SchemaLoadError(
        `'${schemaPath}' \u5904\u7684 schema \u65E0\u6548\uFF1A${err.message}`,
        schemaPath,
        err
      );
    }
    const parseError = err instanceof Error ? err : new Error(String(err));
    throw new SchemaLoadError(
      `\u89E3\u6790 '${schemaPath}' \u5904\u7684 schema \u5931\u8D25\uFF1A${parseError.message}`,
      schemaPath,
      parseError
    );
  }
}
function listSchemas(projectRoot) {
  const schemas = /* @__PURE__ */ new Set();
  const packageDir = getPackageSchemasDir();
  if (fs5.existsSync(packageDir)) {
    for (const entry of fs5.readdirSync(packageDir, { withFileTypes: true })) {
      if (isSchemaDir(packageDir, entry)) {
        const schemaPath = path5.join(packageDir, entry.name, "schema.yaml");
        if (fs5.existsSync(schemaPath)) {
          schemas.add(entry.name);
        }
      }
    }
  }
  const userDir = getUserSchemasDir();
  if (fs5.existsSync(userDir)) {
    for (const entry of fs5.readdirSync(userDir, { withFileTypes: true })) {
      if (isSchemaDir(userDir, entry)) {
        const schemaPath = path5.join(userDir, entry.name, "schema.yaml");
        if (fs5.existsSync(schemaPath)) {
          schemas.add(entry.name);
        }
      }
    }
  }
  if (projectRoot) {
    const projectDir = getProjectSchemasDir(projectRoot);
    if (fs5.existsSync(projectDir)) {
      if (fs5.existsSync(path5.join(projectDir, "schema.yaml"))) {
        schemas.add(DEFAULT_OPENSPEC_SCHEMA);
      }
      for (const entry of fs5.readdirSync(projectDir, { withFileTypes: true })) {
        if (isSchemaDir(projectDir, entry)) {
          const schemaPath = path5.join(projectDir, entry.name, "schema.yaml");
          if (fs5.existsSync(schemaPath)) {
            schemas.add(entry.name);
          }
        }
      }
    }
  }
  return Array.from(schemas).sort();
}
function listSchemasWithInfo(projectRoot) {
  const schemas = [];
  const seenNames = /* @__PURE__ */ new Set();
  if (projectRoot) {
    const projectDir = getProjectSchemasDir(projectRoot);
    if (fs5.existsSync(projectDir)) {
      const flatSchemaPath = path5.join(projectDir, "schema.yaml");
      if (fs5.existsSync(flatSchemaPath)) {
        try {
          const schema = parseSchema(fs5.readFileSync(flatSchemaPath, "utf-8"));
          schemas.push({
            name: DEFAULT_OPENSPEC_SCHEMA,
            description: schema.description || "",
            artifacts: schema.artifacts.map((a) => a.id),
            source: "project"
          });
          seenNames.add(DEFAULT_OPENSPEC_SCHEMA);
        } catch {
        }
      }
      for (const entry of fs5.readdirSync(projectDir, { withFileTypes: true })) {
        if (isSchemaDir(projectDir, entry)) {
          const schemaPath = path5.join(projectDir, entry.name, "schema.yaml");
          if (fs5.existsSync(schemaPath)) {
            try {
              const schema = parseSchema(fs5.readFileSync(schemaPath, "utf-8"));
              schemas.push({
                name: entry.name,
                description: schema.description || "",
                artifacts: schema.artifacts.map((a) => a.id),
                source: "project"
              });
              seenNames.add(entry.name);
            } catch {
            }
          }
        }
      }
    }
  }
  const userDir = getUserSchemasDir();
  if (fs5.existsSync(userDir)) {
    for (const entry of fs5.readdirSync(userDir, { withFileTypes: true })) {
      if (isSchemaDir(userDir, entry) && !seenNames.has(entry.name)) {
        const schemaPath = path5.join(userDir, entry.name, "schema.yaml");
        if (fs5.existsSync(schemaPath)) {
          try {
            const schema = parseSchema(fs5.readFileSync(schemaPath, "utf-8"));
            schemas.push({
              name: entry.name,
              description: schema.description || "",
              artifacts: schema.artifacts.map((a) => a.id),
              source: "user"
            });
            seenNames.add(entry.name);
          } catch {
          }
        }
      }
    }
  }
  const packageDir = getPackageSchemasDir();
  if (fs5.existsSync(packageDir)) {
    for (const entry of fs5.readdirSync(packageDir, { withFileTypes: true })) {
      if (isSchemaDir(packageDir, entry) && !seenNames.has(entry.name)) {
        const schemaPath = path5.join(packageDir, entry.name, "schema.yaml");
        if (fs5.existsSync(schemaPath)) {
          try {
            const schema = parseSchema(fs5.readFileSync(schemaPath, "utf-8"));
            schemas.push({
              name: entry.name,
              description: schema.description || "",
              artifacts: schema.artifacts.map((a) => a.id),
              source: "package"
            });
          } catch {
          }
        }
      }
    }
  }
  return schemas.sort((a, b) => a.name.localeCompare(b.name));
}
