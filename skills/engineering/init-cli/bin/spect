async function captureSpecSnapshots(mutations) {
  return Promise.all(
    mutations.map(async ({ update, outcome, rebuilt }) => {
      try {
        const stat = await import_fs10.promises.lstat(update.target);
        if (stat.isSymbolicLink()) {
          let content;
          let contentExisted = false;
          if (outcome === "write") {
            try {
              content = await import_fs10.promises.readFile(update.target);
              contentExisted = true;
            } catch (error52) {
              if (error52.code !== "ENOENT") throw error52;
            }
          }
          return {
            target: update.target,
            existed: true,
            outcome,
            ...outcome === "write" ? { expectedContent: Buffer.from(rebuilt) } : {},
            content,
            contentExisted,
            symlink: await import_fs10.promises.readlink(update.target)
          };
        }
        return {
          target: update.target,
          existed: true,
          outcome,
          ...outcome === "write" ? { expectedContent: Buffer.from(rebuilt) } : {},
          // Snapshot read for rollback; restoreSpecSnapshots re-checks this
          // content before restoring, so a mid-run change aborts instead of
          // clobbering (CodeQL js/file-system-race).
          ...stat.isFile() ? { content: await import_fs10.promises.readFile(update.target) } : {},
          ...stat.isFile() ? { mode: stat.mode } : {}
        };
      } catch (error52) {
        if (error52.code === "ENOENT") {
          return {
            target: update.target,
            existed: false,
            outcome,
            ...outcome === "write" ? { expectedContent: Buffer.from(rebuilt) } : {}
          };
        }
        throw error52;
      }
    })
  );
}
async function restoreSpecSnapshots(snapshots) {
  const errors = [];
  for (const snapshot of [...snapshots].reverse()) {
    try {
      if (snapshot.outcome === "retire") {
        if (snapshot.displacedPath !== void 0) {
          try {
            await import_fs10.promises.lstat(snapshot.target);
            throw new Error(
              `${rollbackWouldOverwriteMessage(snapshot.target)} \u88AB\u79FB\u8D70\u7684 spec \u5DF2\u4FDD\u7559\u5728 ${snapshot.displacedPath}\u3002`
            );
          } catch (error52) {
            if (error52.code !== "ENOENT") throw error52;
          }
          await import_fs10.promises.rename(snapshot.displacedPath, snapshot.target);
          snapshot.displacedPath = void 0;
          continue;
        }
        try {
          const current = await import_fs10.promises.lstat(snapshot.target);
          const unchangedSymlink = snapshot.symlink !== void 0 && current.isSymbolicLink() && await import_fs10.promises.readlink(snapshot.target) === snapshot.symlink;
          const unchangedFile = snapshot.symlink === void 0 && snapshot.content !== void 0 && current.isFile() && (await import_fs10.promises.readFile(snapshot.target)).equals(snapshot.content);
          if (unchangedSymlink || unchangedFile) continue;
          throw new Error(
            `Archive rollback would overwrite a concurrent change at ${snapshot.target}.`
          );
        } catch (error52) {
          if (error52.code !== "ENOENT") throw error52;
        }
      } else {
        let current;
        try {
          current = await import_fs10.promises.lstat(snapshot.target);
        } catch (error52) {
          if (error52.code === "ENOENT" && !snapshot.existed) {
            continue;
          }
          throw error52;
        }
        if (snapshot.symlink !== void 0 && (!current.isSymbolicLink() || await import_fs10.promises.readlink(snapshot.target) !== snapshot.symlink) || snapshot.symlink === void 0 && (!current.isFile() || snapshot.mode !== void 0 && current.mode !== snapshot.mode)) {
          throw new Error(
            `Archive rollback would overwrite a concurrent change at ${snapshot.target}.`
          );
        }
        const currentContent = await import_fs10.promises.readFile(snapshot.target);
        const originalContent = snapshot.symlink !== void 0 && !snapshot.contentExisted ? void 0 : snapshot.content;
        if (originalContent !== void 0 && currentContent.equals(originalContent)) {
          continue;
        }
        if (snapshot.expectedContent === void 0 || !currentContent.equals(snapshot.expectedContent)) {
          throw new Error(
            `Archive rollback would overwrite a concurrent change at ${snapshot.target}.`
          );
        }
      }
      if (!snapshot.existed) {
        await import_fs10.promises.rm(snapshot.target, { force: true });
        continue;
      }
      if (snapshot.symlink !== void 0) {
        if (snapshot.outcome === "retire") {
          await import_fs10.promises.mkdir(import_path9.default.dirname(snapshot.target), { recursive: true });
          await import_fs10.promises.symlink(snapshot.symlink, snapshot.target);
        } else if (snapshot.contentExisted) {
          await import_fs10.promises.writeFile(snapshot.target, snapshot.content);
        } else {
          const referent = import_path9.default.resolve(import_path9.default.dirname(snapshot.target), snapshot.symlink);
          await import_fs10.promises.rm(referent, { force: true });
        }
        continue;
      }
      if (snapshot.content !== void 0) {
        await import_fs10.promises.mkdir(import_path9.default.dirname(snapshot.target), { recursive: true });
        await import_fs10.promises.writeFile(snapshot.target, snapshot.content);
        if (snapshot.mode !== void 0) await import_fs10.promises.chmod(snapshot.target, snapshot.mode);
      }
    } catch (error52) {
      errors.push(error52 instanceof Error ? error52 : new Error(String(error52)));
    }
  }
  if (errors.length > 0) {
    throw new Error(errors.map(({ message }) => message).join(" "));
  }
}
async function finalizeRetirementBackups(snapshots, mainSpecsDir) {
  const errors = [];
  for (const snapshot of snapshots) {
    if (snapshot.outcome !== "retire" || snapshot.displacedPath === void 0) continue;
    const displacedPath = snapshot.displacedPath;
    try {
      if (snapshot.displacedFingerprint === void 0 || await fingerprintMovablePath(displacedPath) !== snapshot.displacedFingerprint) {
        throw new Error("\u88AB\u79FB\u8D70\u7684 spec \u5728\u9000\u5F79\u6821\u9A8C\u540E\u53D1\u751F\u4E86\u53D8\u5316");
      }
      await finalizeRetiredSpec(snapshot.target, displacedPath, mainSpecsDir);
      snapshot.displacedPath = void 0;
    } catch (error52) {
      errors.push(
        `Could not remove the committed retirement backup at ${displacedPath} (${error52 instanceof Error ? error52.message : String(error52)}).`
      );
    }
  }
  if (errors.length > 0) {
    throw new RetirementBackupsRetainedError(
      `${errors.join(" ")} The change remains archived and each listed backup was retained for recovery.`
    );
  }
}
var ArchiveCommand = class {
  async execute(changeName, options = {}) {
    const json2 = !!options.json;
    let root;
    try {
      root = await resolveOpenSpecRoot({
        ...options.store !== void 0 ? { store: options.store } : {},
        ...options.storePath !== void 0 ? { storePath: options.storePath } : {}
      });
    } catch (error52) {
      if (json2 && isRootSelectionError(error52)) {
        this.printJsonFailure(void 0, toArchiveDiagnostic(error52));
        return;
      }
      throw error52;
    }
    if (json2) {
      try {
        const result = await this.run(changeName, options, root, true);
        if (!result) {
          return;
        }
        console.log(JSON.stringify({ archive: result, root: toRootOutput(root) }, null, 2));
      } catch (error52) {
        this.printJsonFailure(root, toArchiveDiagnostic(error52));
      }
      return;
    }
    emitStoreRootBanner(root);
    await this.run(changeName, options, root, false);
  }
  printJsonFailure(root, diagnostic) {
    console.log(
      JSON.stringify(
        {
          archive: null,
          ...root ? { root: toRootOutput(root) } : {},
          status: [diagnostic]
        },
        null,
        2
      )
    );
    process.exitCode = 1;
  }
  /**
   * Shared archive flow. In human mode (json=false) prompts and prose match
   * the historical behavior and cancellations return null. In JSON mode no
   * prose reaches stdout and every blocked path throws.
   */
  async run(changeName, options, root, json2) {
    const changesDir = root.changesDir;
    const archiveDir = root.archiveDir;
    const mainSpecsDir = root.specsDir;
    for (const [allowedDirectory, managedDir] of [
      [root.path, changesDir],
      [changesDir, archiveDir],
      [root.path, mainSpecsDir]
    ]) {
      try {
        FileSystemUtils.assertPathWithin(allowedDirectory, managedDir);
      } catch {
        throw new ArchiveBlockedError(
          "archive_path_outside_root",
          `\u62D2\u7EDD\u901A\u8FC7 OpenSpec \u6839\u76EE\u5F55\u4E4B\u5916\u7684\u8DEF\u5F84\u8FDB\u884C\u5F52\u6863\uFF1A${managedDir}`
        );
      }
    }
    if (!changeName) {
      if (json2) {
        throw new ArchiveBlockedError(
          "archive_change_name_required",
          "\u9700\u8981\u53D8\u66F4\u540D\u79F0\uFF1Aarchive --json \u4E3A\u975E\u4EA4\u4E92\u6A21\u5F0F\u3002",
          withStoreFlag(root, "spect archive <change-name> --json")
        );
      }
      const selectedChange = await this.selectChange(changesDir, root, options);
      if (!selectedChange) {
        console.log("\u672A\u9009\u62E9\u53D8\u66F4\u3002\u5DF2\u4E2D\u6B62\u3002");
        return null;
      }
      changeName = selectedChange;
    }
    const changeNameProblem = folderStyleNameProblem(changeName, "\u53D8\u66F4\u540D\u79F0");
    if (changeNameProblem) {
      throw new ArchiveBlockedError("archive_change_name_invalid", changeNameProblem);
    }
    const changeDir = import_path9.default.join(changesDir, changeName);
    try {
      const stat = await import_fs10.promises.lstat(changeDir);
      if (stat.isSymbolicLink()) {
        throw new ArchiveBlockedError(
          "archive_change_symlink",
          `\u53D8\u66F4 '${changeName}' \u662F\u4E00\u4E2A\u7B26\u53F7\u94FE\u63A5\u3002\u8BF7\u5728\u5F52\u6863\u524D\u5C06\u5176\u66FF\u6362\u4E3A\u771F\u5B9E\u7684\u76EE\u5F55\u3002`
        );
      }
      if (!stat.isDirectory()) {
        throw new Error(`\u672A\u627E\u5230\u53D8\u66F4 '${changeName}'\u3002`);
      }
    } catch (error52) {
      if (error52 instanceof ArchiveBlockedError) throw error52;
      const available = await listActiveChangeNames(changesDir);
      throw new ArchiveBlockedError(
        "archive_change_not_found",
        available.length > 0 ? `\u672A\u627E\u5230\u53D8\u66F4 '${changeName}'\u3002\u53EF\u7528\u7684\u53D8\u66F4\uFF1A${available.join(", ")}` : `\u672A\u627E\u5230\u53D8\u66F4 '${changeName}'\u3002\u6B64\u6839\u76EE\u5F55\u4E0B\u4E0D\u5B58\u5728\u6D3B\u8DC3\u7684\u53D8\u66F4\u3002`
      );
    }
    const skipValidation = options.validate === false || options.noValidate === true;
    if (!skipValidation) {
      const validator = new Validator();
