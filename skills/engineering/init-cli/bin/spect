var REPO_DEFAULT_SCHEMA = "spec-driven";
function pathExistsAsDirectory(candidatePath) {
  try {
    return fs13.statSync(candidatePath).isDirectory();
  } catch {
    return false;
  }
}
function getSearchStartDirectory(startPath) {
  const resolved = path14.resolve(startPath);
  try {
    const stats = fs13.statSync(resolved);
    const searchStart = stats.isDirectory() ? resolved : path14.dirname(resolved);
    return FileSystemUtils.canonicalizeExistingPath(searchStart);
  } catch {
    return resolved;
  }
}
function findNearestAncestor(startPath, predicate) {
  let currentDir = getSearchStartDirectory(startPath);
  while (true) {
    if (predicate(currentDir)) {
      return FileSystemUtils.canonicalizeExistingPath(currentDir);
    }
    const parentDir = path14.dirname(currentDir);
    if (parentDir === currentDir) {
      return null;
    }
    currentDir = parentDir;
  }
}
function findRepoPlanningRootSync(startPath = process.cwd()) {
  return findNearestAncestor(
    startPath,
    (dirPath) => pathExistsAsDirectory(path14.join(dirPath, "openspec"))
  );
}
