function isLexicallyWithin(allowedDirectory, targetPath) {
  const relative2 = import_path8.default.relative(import_path8.default.resolve(allowedDirectory), import_path8.default.resolve(targetPath));
  return relative2 === "" || relative2 !== ".." && !relative2.startsWith(`..${import_path8.default.sep}`) && !import_path8.default.isAbsolute(relative2);
}
function resolveTrustedSpecPath(specsRoot, specPath) {
  if (!isLexicallyWithin(specsRoot, specPath)) {
    throw new Error(`\u8DEF\u5F84\u4F4D\u4E8E\u5141\u8BB8\u7684\u76EE\u5F55\u4E4B\u5916\uFF1A${specPath}`);
  }
  try {
    FileSystemUtils.assertPathWithin(specsRoot, specPath);
    const root = FileSystemUtils.canonicalizeExistingPath(specsRoot);
    return {
      root,
      // Rebase onto the canonical root so missing targets also work when the
      // project is reached through an OS path alias (for example /var on macOS).
      file: import_path8.default.join(root, import_path8.default.relative(import_path8.default.resolve(specsRoot), import_path8.default.resolve(specPath)))
    };
  } catch {
    const root = FileSystemUtils.canonicalizeExistingPath(import_path8.default.dirname(specPath));
    const file2 = import_path8.default.join(root, import_path8.default.basename(specPath));
    FileSystemUtils.assertPathWithin(root, file2);
    return { root, file: file2 };
  }
}
function assertTrustedSpecPath(root, specPath) {
  if (FileSystemUtils.canonicalizeExistingPath(root) !== import_path8.default.resolve(root)) {
    throw new Error(`\u8DEF\u5F84\u4F4D\u4E8E\u5141\u8BB8\u7684\u76EE\u5F55\u4E4B\u5916\uFF1A${specPath}`);
  }
  FileSystemUtils.assertPathWithin(root, specPath);
}
async function findSpecUpdates(changeDir, mainSpecsDir) {
  const updates = [];
  const changeSpecsDir = import_path8.default.join(changeDir, "specs");
  const discovered = await discoverSpecFiles(changeSpecsDir);
  for (const { id, specFile } of discovered) {
    const targetFile = import_path8.default.join(mainSpecsDir, ...id.split("/"), "spec.md");
    const source = resolveTrustedSpecPath(changeSpecsDir, specFile);
    const target = resolveTrustedSpecPath(mainSpecsDir, targetFile);
    let exists = false;
    try {
      await import_fs8.promises.access(target.file);
      exists = true;
    } catch {
      exists = false;
    }
    updates.push({
      id,
      sourceRoot: source.root,
      source: source.file,
      targetRoot: target.root,
      target: target.file,
      exists
    });
  }
  return updates;
}
async function buildUpdatedSpec(update, changeName, options = {}) {
  const warnings = [];
