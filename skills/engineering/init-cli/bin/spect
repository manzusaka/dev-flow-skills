          hasRootLevelSpec = rootSpecStat?.isFile() === true;
          if (hasRootLevelSpec) {
            issues.push({
              level: "ERROR",
              path: "spec.md",
              message: "\u5728 specs/spec.md \u5904\u53D1\u73B0\u4E86\u589E\u91CF\u89C4\u8303\uFF08delta spec\uFF09\u3002\u589E\u91CF\u89C4\u8303\u5FC5\u987B\u4F4D\u4E8E\u80FD\u529B\u8DEF\u5F84\u4E4B\u4E0B\uFF08\u4F8B\u5982 specs/<capability-path>/spec.md\uFF09\u2014\u2014\u653E\u5728 specs/ \u6839\u76EE\u5F55\u4E0B\u7684\u6587\u4EF6\u5728\u53D8\u66F4\u88AB\u5E94\u7528\u6216\u5F52\u6863\u65F6\u4F1A\u88AB\u5FFD\u7565\u3002"
