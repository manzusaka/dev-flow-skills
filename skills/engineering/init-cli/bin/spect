  await import_fs8.promises.writeFile(update.target, rebuilt);
  if (options.silent) return;
  const specName = update.id;
  console.log(`\u6B63\u5728\u5E94\u7528\u53D8\u66F4\u5230 ${options.displayPath ?? `openspec/specs/${specName}/spec.md`}\uFF1A`);
  if (counts.added) console.log(`  + ${counts.added} \u65B0\u589E`);
  if (counts.modified) console.log(`  ~ ${counts.modified} \u4FEE\u6539`);
  if (counts.removed) console.log(`  - ${counts.removed} \u79FB\u9664`);
  if (counts.renamed) console.log(`  \u2192 ${counts.renamed} \u91CD\u547D\u540D`);
}
function maskHtmlComments(content) {
  const blank = (text) => text.replace(/[^\n]/g, " ");
  const masked = content.replace(/<!--[\s\S]*?--!?>/g, blank);
  const unterminated = masked.indexOf("<!--");
  if (unterminated === -1) return masked;
  return masked.slice(0, unterminated) + blank(masked.slice(unterminated));
}
function extractPurposeSection(content) {
  const normalized = content.replace(/\r\n?/g, "\n");
  const lines = normalized.split("\n");
  const masked = maskHtmlComments(normalized).split("\n");
  const fenceMask = buildCodeFenceMask(masked);
  const isStructural = (i) => !fenceMask[i];
  const start = masked.findIndex((line, i) => isStructural(i) && /^##\s+Purpose\s*$/i.test(line));
  if (start === -1) return void 0;
  let end = masked.length;
  for (let i = start + 1; i < masked.length; i++) {
    if (isStructural(i) && /^##\s+/.test(masked[i])) {
      end = i;
      break;
    }
  }
  const hasProse = masked.slice(start + 1, end).filter((_, offset) => isStructural(start + 1 + offset)).join("\n").trim();
  if (!hasProse) return void 0;
  const body = lines.slice(start + 1, end).join("\n").trim();
  return body || void 0;
}
function readableOverview(skeleton, specName) {
  if (skeleton.includes("<!--")) return null;
  if (findMainSpecStructureIssues(skeleton).length > 0) return null;
  try {
    return new MarkdownParser(skeleton).parseSpec(specName).overview.trim() || null;
  } catch {
    return null;
  }
}
function buildSpecSkeleton(specFolderName, changeName, purpose) {
  const titleBase = specFolderName;
  const purposeBody = purpose?.trim() || `TBD - created by archiving change ${changeName}. Update Purpose after archive.`;
  return `# ${titleBase} Specification

## Purpose
${purposeBody}

## Requirements
`;
}

