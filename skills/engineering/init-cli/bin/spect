function readBooleanMarker(changeDir, key) {
  let raw;
  try {
    raw = fs6.readFileSync(path7.join(changeDir, METADATA_FILENAME), "utf-8");
  } catch (err) {
    if (err?.code === "ENOENT") {
      return { declared: false };
    }
    const message = err instanceof Error ? err.message : String(err);
    return {
      declared: false,
      invalidReason: `\u5143\u6570\u636E\u6587\u4EF6\u65E0\u6CD5\u8BFB\u53D6\uFF08${message}\uFF09`
    };
  }
  let parsed;
  try {
    parsed = yaml.parse(raw);
  } catch {
    const mentioned = new RegExp(`^\\s*(['"]?)${key}\\1\\s*:`, "m").test(raw);
    return mentioned ? { declared: false, invalidReason: "\u8BE5\u6587\u4EF6\u4E0D\u662F\u6709\u6548\u7684 YAML" } : { declared: false };
  }
  const result = ChangeMetadataSchema.safeParse(parsed);
  if (result.success) {
    if (result.data[key] !== true) {
      return { declared: false };
    }
    try {
      const projectRoot = path7.resolve(changeDir, "../../..");
      if (!listSchemas(projectRoot).includes(result.data.schema)) {
        return {
          declared: false,
          invalidReason: `schema\uFF1A\u672A\u77E5 schema '${result.data.schema}'`
        };
      }
      resolveSchema(result.data.schema, projectRoot);
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      return { declared: false, invalidReason: message };
    }
    return { declared: true };
  }
  const markerMentioned = typeof parsed === "object" && parsed !== null && key in parsed && parsed[key] !== false;
  if (markerMentioned) {
    const first = result.error.issues[0];
    const where = first.path.length > 0 ? `${first.path.join(".")}: ` : "";
    return { declared: false, invalidReason: `${where}${first.message}` };
  }
  return { declared: false };
}
