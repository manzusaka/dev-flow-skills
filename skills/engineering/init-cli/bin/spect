function parseDeclarationList(raw) {
  const fieldName = "references";
  if (raw === void 0) {
    return void 0;
  }
  if (!Array.isArray(raw)) {
    console.warn(`\u914D\u7F6E\u4E2D\u7684 '${fieldName}' \u5B57\u6BB5\u65E0\u6548\uFF08\u5FC5\u987B\u662F store id \u6570\u7EC4\uFF09`);
    return void 0;
  }
  const byId = /* @__PURE__ */ new Map();
  let droppedEntries = false;
  let droppedRemotes = false;
  for (const entry of raw) {
    let declaration = null;
    if (typeof entry === "string") {
      declaration = { id: entry };
    } else if (entry && typeof entry === "object" && !Array.isArray(entry)) {
      const candidate = entry;
      if (typeof candidate.id === "string") {
        declaration = { id: candidate.id };
        if (typeof candidate.remote === "string" && candidate.remote.length > 0) {
          declaration.remote = candidate.remote;
        } else if (candidate.remote !== void 0) {
          droppedRemotes = true;
        }
      }
    }
    if (!declaration) {
      droppedEntries = true;
      continue;
    }
    const existing = byId.get(declaration.id);
    if (!existing) {
      byId.set(declaration.id, declaration);
    } else if (existing.remote === void 0 && declaration.remote !== void 0) {
      existing.remote = declaration.remote;
    }
  }
  if (droppedEntries) {
    console.warn(`'${fieldName}' \u90E8\u5206\u6761\u76EE\u65E0\u6548\uFF0C\u5DF2\u5FFD\u7565`);
  }
  if (droppedRemotes) {
    console.warn(
      `'${fieldName}' \u90E8\u5206\u8FDC\u7A0B\u6761\u76EE\u4E0D\u662F\u975E\u7A7A\u5B57\u7B26\u4E32\uFF1B\u8FD9\u4E9B id \u5C06\u4FDD\u7559\u4F46\u4E0D\u5E26\u514B\u9686\u6765\u6E90`
    );
  }
  return byId.size > 0 ? [...byId.values()] : void 0;
}
