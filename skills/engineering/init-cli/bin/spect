function statusFromError(error52) {
  if (isRootSelectionError(error52)) {
    return { ...error52.diagnostic };
  }
  return {
    severity: "error",
    code: "change_error",
    message: error52 instanceof Error ? error52.message : String(error52)
  };
}
function isColorDisabled() {
  return process.env.NO_COLOR === "1" || process.env.NO_COLOR === "true";
}
function getStatusColor(status) {
  if (isColorDisabled()) {
    return (text) => text;
  }
  switch (status) {
    case "done":
      return source_default.green;
    case "skipped":
      return source_default.gray;
    case "ready":
      return source_default.yellow;
    case "blocked":
      return source_default.red;
  }
}
function getStatusIndicator(status) {
  const color = getStatusColor(status);
  switch (status) {
    case "done":
      return color("[x]");
    case "skipped":
      return color("[~]");
    case "ready":
      return color("[ ]");
    case "blocked":
      return color("[-]");
  }
}
async function getAvailableChanges(projectRoot, changesDir = import_path11.default.join(projectRoot, "openspec", "changes")) {
  const changesPath = changesDir;
  try {
    const entries = await fs18.promises.readdir(changesPath, { withFileTypes: true });
    return entries.filter((e) => e.isDirectory() && e.name !== "archive" && !e.name.startsWith(".")).map((e) => e.name);
  } catch (error52) {
    if (error52.code === "ENOENT") return [];
    throw error52;
  }
}
function validateChangeLookupName(changeName) {
  if (changeName === "." || changeName === "..") {
    return "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u662F\u76F8\u5BF9\u8DEF\u5F84\u6BB5";
  }
  if (changeName.includes("/") || changeName.includes("\\")) {
    return "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u5305\u542B\u8DEF\u5F84\u5206\u9694\u7B26";
  }
  if (changeName.includes("\0")) {
    return "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u5305\u542B\u7A7A\u5B57\u7B26";
  }
  if (changeName.startsWith(".")) {
    return "\u53D8\u66F4\u540D\u79F0\u4E0D\u80FD\u4EE5\u70B9\u53F7\u5F00\u5934";
  }
  if (changeName === "archive") {
    return "'archive' \u662F\u4E3A\u5F52\u6863\u53D8\u66F4\u4FDD\u7559\u7684";
  }
  return void 0;
}
async function validateChangeExists(changeName, projectRoot, changesDir = import_path11.default.join(projectRoot, "openspec", "changes"), hints = {}) {
  const newChangeHint = hints.newChangeHint ?? "spect new change <name>";
  if (!changeName) {
    const available = await getAvailableChanges(projectRoot, changesDir);
    if (available.length === 0) {
      throw new Error(`\u672A\u627E\u5230\u53D8\u66F4\u3002\u4F7F\u7528\u4EE5\u4E0B\u547D\u4EE4\u521B\u5EFA\uFF1A${newChangeHint}`);
    }
    throw new Error(
      `\u7F3A\u5C11\u5FC5\u9700\u9009\u9879 --change\u3002\u53EF\u7528\u7684\u53D8\u66F4\uFF1A
  ${available.join("\n  ")}`
    );
  }
  const lookupError = validateChangeLookupName(changeName);
  if (lookupError) {
    throw new Error(`\u65E0\u6548\u7684\u53D8\u66F4\u540D\u79F0 '${changeName}'\uFF1A${lookupError}`);
  }
  const changePath = import_path11.default.join(changesDir, changeName);
  const exists = fs18.existsSync(changePath) && fs18.statSync(changePath).isDirectory();
  if (!exists) {
    const available = await getAvailableChanges(projectRoot, changesDir);
    if (available.length === 0) {
      throw new Error(
        `\u672A\u627E\u5230\u53D8\u66F4 '${changeName}'\u3002\u4E0D\u5B58\u5728\u4EFB\u4F55\u53D8\u66F4\u3002\u4F7F\u7528\u4EE5\u4E0B\u547D\u4EE4\u521B\u5EFA\uFF1A${newChangeHint}`
      );
    }
    throw new Error(
      `\u672A\u627E\u5230\u53D8\u66F4 '${changeName}'\u3002\u53EF\u7528\u7684\u53D8\u66F4\uFF1A
  ${available.join("\n  ")}`
    );
  }
  return changeName;
}
function validateSchemaExists(schemaName, projectRoot) {
  const schemaDir = getSchemaDir(schemaName, projectRoot);
  if (!schemaDir) {
    const availableSchemas = listSchemas(projectRoot);
    throw new Error(
      `\u672A\u627E\u5230 Schema '${schemaName}'\u3002\u53EF\u7528\u7684 schemas\uFF1A
  ${availableSchemas.join("\n  ")}`
    );
  }
  return schemaName;
}

// src/utils/match.ts
function nearestMatches(input, candidates, max = 5) {
  const scored = candidates.map((candidate) => ({ candidate, distance: levenshtein(input, candidate) }));
  scored.sort((a, b) => a.distance - b.distance);
  return scored.slice(0, max).map((s) => s.candidate);
}
function levenshtein(a, b) {
  const m = a.length;
  const n = b.length;
  const dp = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
  for (let i = 0; i <= m; i++) dp[i][0] = i;
  for (let j = 0; j <= n; j++) dp[0][j] = j;
  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[i][j] = Math.min(
        dp[i - 1][j] + 1,
        dp[i][j - 1] + 1,
        dp[i - 1][j - 1] + cost
      );
    }
  }
  return dp[m][n];
}

// src/commands/validate.ts
var import_fs12 = require("fs");
init_task_progress();
init_file_system();
var ValidateCommand = class {
  async execute(itemName, options = {}) {
    const bulk = options.all || options.changes || options.specs;
    const root = await resolveRootForCommand(options, {
      json: options.json,
      ...bulk ? { allowImplicitRoot: false } : {}
    });
    if (!root) {
      return;
    }
    const interactive = isInteractive2(options);
    if (options.archived) {
      await this.runArchivedTaskValidation(root, {
        json: !!options.json,
        noInteractive: resolveNoInteractive(options)
      });
      return;
    }
    if (bulk) {
      await this.runBulkValidation(root, {
        changes: !!options.all || !!options.changes,
        specs: !!options.all || !!options.specs
      }, { strict: !!options.strict, json: !!options.json, concurrency: options.concurrency, noInteractive: resolveNoInteractive(options) });
      return;
    }
    if (!itemName) {
      if (interactive) {
        await this.runInteractiveSelector(root, { strict: !!options.strict, json: !!options.json, concurrency: options.concurrency });
        return;
      }
      this.printNonInteractiveHint(root);
      process.exitCode = 1;
      return;
    }
    const typeOverride = this.normalizeType(options.type);
    await this.validateDirectItem(root, itemName, { typeOverride, strict: !!options.strict, json: !!options.json });
  }
  normalizeType(value) {
    if (!value) return void 0;
    const v = value.toLowerCase();
    if (v === "change" || v === "spec") return v;
    return void 0;
  }
  /**
   * Resolve change IDs by directory existence within the resolved root — the
   * same rule `openspec status`/`instructions` use (`getAvailableChanges`) —
   * rather than requiring `proposal.md`. This lets `validate` resolve a
   * scaffolded or still-authoring change that the sibling commands already
   * resolve (#1182). Sorted to preserve the prior `getActiveChangeIds` ordering.
   */
  async listChangeIds(root) {
    const ids = await getAvailableChanges(root.path, root.changesDir);
    return ids.sort();
  }
  async runInteractiveSelector(root, opts) {
    const { select } = await Promise.resolve().then(() => (init_esm15(), esm_exports));
    const choice = await select({
      message: "\u60A8\u60F3\u8981\u9A8C\u8BC1\u4EC0\u4E48\uFF1F",
      choices: [
        { name: "\u5168\u90E8\uFF08\u53D8\u66F4 + \u89C4\u8303\uFF09", value: "all" },
        { name: "\u6240\u6709\u53D8\u66F4", value: "changes" },
        { name: "\u6240\u6709\u89C4\u8303", value: "specs" },
        { name: "\u9009\u62E9\u7279\u5B9A\u7684\u53D8\u66F4\u6216\u89C4\u8303", value: "one" }
      ]
    });
    if (choice === "all") return this.runBulkValidation(root, { changes: true, specs: true }, opts);
    if (choice === "changes") return this.runBulkValidation(root, { changes: true, specs: false }, opts);
    if (choice === "specs") return this.runBulkValidation(root, { changes: false, specs: true }, opts);
    const [changes, specs] = await Promise.all([this.listChangeIds(root), getSpecIds(root.path)]);
    const items = [];
    items.push(...changes.map((id) => ({ name: `change/${id}`, value: { type: "change", id } })));
    items.push(...specs.map((id) => ({ name: `spec/${id}`, value: { type: "spec", id } })));
    if (items.length === 0) {
      console.error("\u672A\u627E\u5230\u8981\u9A8C\u8BC1\u7684\u9879\u76EE\u3002");
      process.exitCode = 1;
      return;
    }
    const picked = await select({ message: "\u9009\u62E9\u4E00\u4E2A\u9879\u76EE", choices: items });
    await this.validateByType(root, picked.type, picked.id, opts);
  }
  printNonInteractiveHint(root) {
    console.error("\u6CA1\u6709\u53EF\u9A8C\u8BC1\u7684\u5185\u5BB9\u3002\u8BF7\u5C1D\u8BD5\u4EE5\u4E0B\u4E4B\u4E00\uFF1A");
    console.error(`  ${withStoreFlag(root, "spect validate --all")}`);
    console.error(`  ${withStoreFlag(root, "spect validate --changes")}`);
    console.error(`  ${withStoreFlag(root, "spect validate --specs")}`);
    console.error(`  ${withStoreFlag(root, "spect validate <item-name>")}`);
    console.error("\u6216\u5728\u4EA4\u4E92\u5F0F\u7EC8\u7AEF\u4E2D\u8FD0\u884C\u3002");
  }
  async validateDirectItem(root, itemName, opts) {
    const [changes, specs] = await Promise.all([this.listChangeIds(root), getSpecIds(root.path)]);
    const isChange = changes.includes(itemName);
    const isSpec = specs.includes(itemName);
    const type = opts.typeOverride ?? (isChange ? "change" : isSpec ? "spec" : void 0);
    if (!type) {
      const suggestions = nearestMatches(itemName, [...changes, ...specs]);
      const message = suggestions.length ? `\u672A\u77E5\u9879\u76EE '${itemName}'\u3002\u60A8\u662F\u5426\u60F3\u8981\uFF1A${suggestions.join(", ")}?` : `\u672A\u77E5\u9879\u76EE '${itemName}'\u3002`;
      if (opts.json) {
        console.log(
          JSON.stringify(
            { status: [{ severity: "error", code: "unknown_item", message }] },
            null,
            2
          )
        );
      } else {
        console.error(message);
      }
      process.exitCode = 1;
      return;
    }
    if (!opts.typeOverride && isChange && isSpec) {
      if (opts.json) {
        console.log(
          JSON.stringify(
            {
              status: [
                {
                  severity: "error",
                  code: "ambiguous_item",
                  message: `\u6A21\u7CCA\u7684\u9879\u76EE '${itemName}' \u540C\u65F6\u5339\u914D\u53D8\u66F4\u548C\u89C4\u8303\u3002`,
                  fix: "\u4F20\u9012 --type change|spec\u3002"
                }
              ]
            },
            null,
            2
          )
        );
        process.exitCode = 1;
        return;
      }
      console.error(`\u6A21\u7CCA\u7684\u9879\u76EE '${itemName}' \u540C\u65F6\u5339\u914D\u53D8\u66F4\u548C\u89C4\u8303\u3002`);
      if (isStoreSelectedRoot(root)) {
        console.error("\u4F20\u9012 --type change|spec\u3002");
      } else {
        console.error("\u4F20\u9012 --type change|spec\uFF0C\u6216\u4F7F\u7528\uFF1Aspect change validate / spect spec validate");
      }
      process.exitCode = 1;
      return;
    }
    await this.validateByType(root, type, itemName, opts);
  }
  async validateByType(root, type, id, opts) {
    const validator = new Validator(opts.strict);
    if (type === "change") {
      const changeDir = import_path12.default.join(root.changesDir, id);
      const start2 = Date.now();
      const report2 = await validator.validateChangeDeltaSpecs(changeDir, {
        mainSpecsDir: root.specsDir,
        projectRoot: root.path
      });
      const durationMs2 = Date.now() - start2;
      this.printReport("change", id, report2, durationMs2, opts.json, root);
      process.exitCode = report2.valid ? 0 : 1;
      return;
    }
    const file2 = import_path12.default.join(root.specsDir, id, "spec.md");
    const start = Date.now();
    const report = await validator.validateSpec(file2);
    const durationMs = Date.now() - start;
    this.printReport("spec", id, report, durationMs, opts.json, root);
    process.exitCode = report.valid ? 0 : 1;
  }
  printReport(type, id, report, durationMs, json2, root) {
    if (json2) {
      const out = { items: [{ id, type, valid: report.valid, issues: report.issues, durationMs }], summary: { totals: { items: 1, passed: report.valid ? 1 : 0, failed: report.valid ? 0 : 1 }, byType: { [type]: { items: 1, passed: report.valid ? 1 : 0, failed: report.valid ? 0 : 1 } } }, version: "1.0", root: toRootOutput(root) };
      console.log(JSON.stringify(out, null, 2));
      return;
    }
    if (report.valid) {
      console.log(`${type === "change" ? "\u53D8\u66F4" : "\u89C4\u8303"} '${id}' \u9A8C\u8BC1\u901A\u8FC7`);
    } else {
      console.error(`${type === "change" ? "\u53D8\u66F4" : "\u89C4\u8303"} '${id}' \u5B58\u5728\u95EE\u9898`);
      for (const issue2 of report.issues) {
        const label = issue2.level === "ERROR" ? "ERROR" : issue2.level;
        const prefix = issue2.level === "ERROR" ? "\u2717" : issue2.level === "WARNING" ? "\u26A0" : "\u2139";
        console.error(`${prefix} [${label}] ${issue2.path}: ${issue2.message}`);
      }
      this.printNextSteps(type, id, root, report.issues);
    }
  }
  printNextSteps(type, id, root, issues = []) {
    const bullets = [];
    const conflictIssue = issues.some(
      (i) => i.message.includes(VALIDATION_MESSAGES.CHANGE_SKIP_SPECS_CONFLICT)
    );
    const invalidMarkerIssue = issues.some(
      (i) => i.message.includes(VALIDATION_MESSAGES.CHANGE_SKIP_SPECS_INVALID_METADATA)
    );
    if (type === "change" && conflictIssue) {
      bullets.push("- \u6B64\u53D8\u66F4\u58F0\u660E\u4E86 skip_specs\uFF08\u65E0 spec deltas\uFF09\uFF1A\u8BF7\u5220\u9664 specs/ \u4E0B\u7684\u6587\u4EF6\uFF1B\u5982\u679C\u9700\u6C42\u786E\u5B9E\u53D1\u751F\u4E86\u53D8\u5316\uFF0C\u5219\u4ECE .openspec.yaml \u4E2D\u79FB\u9664 skip_specs");
      bullets.push("- \u53EA\u6709\u5F53 .openspec.yaml \u662F\u6709\u6548\u7684\u53D8\u66F4\u5143\u6570\u636E\u65F6\uFF0Cskip_specs \u624D\u4F1A\u751F\u6548\uFF08\u5FC5\u987B\u5305\u542B schema: <name> \u4E14\u6307\u5411\u4E00\u4E2A\u5DF2\u77E5\u7684 schema\uFF09");
    } else if (type === "change" && invalidMarkerIssue) {
      bullets.push("- \u8BF7\u4FEE\u590D .openspec.yaml\uFF0C\u4F7F skip_specs \u6807\u8BB0\u80FD\u591F\u751F\u6548\uFF08\u5FC5\u987B\u5305\u542B schema: <name> \u4E14\u6307\u5411\u4E00\u4E2A\u5DF2\u77E5\u7684 schema\uFF09");
      bullets.push("- \u6216\u8005\u4ECE .openspec.yaml \u4E2D\u79FB\u9664 skip_specs\uFF0C\u6539\u4E3A\u6DFB\u52A0 delta specs");
    } else if (type === "change") {
      bullets.push("- \u786E\u4FDD\u53D8\u66F4\u5728 specs/ \u4E2D\u6709 deltas\uFF1A\u4F7F\u7528 ## ADDED/MODIFIED/REMOVED/RENAMED Requirements \u6807\u9898");
      bullets.push("- \u6BCF\u4E2A\u9700\u6C42\u5FC5\u987B\u5305\u542B\u81F3\u5C11\u4E00\u4E2A #### Scenario: \u5757");
      bullets.push(`- \u8C03\u8BD5\u89E3\u6790\u7684 deltas\uFF1A${withStoreFlag(root, `spect show ${id} --json --deltas-only`)}`);
    } else {
      bullets.push("- \u786E\u4FDD\u89C4\u8303\u5305\u542B ## Purpose \u548C ## Requirements \u90E8\u5206");
      bullets.push("- \u6BCF\u4E2A\u9700\u6C42\u5FC5\u987B\u5305\u542B\u81F3\u5C11\u4E00\u4E2A #### Scenario: \u5757");
      bullets.push("- \u4F7F\u7528 --json \u91CD\u65B0\u8FD0\u884C\u4EE5\u67E5\u770B\u7ED3\u6784\u5316\u62A5\u544A");
    }
    console.error("\u540E\u7EED\u6B65\u9AA4\uFF1A");
    bullets.forEach((b) => console.error(`  ${b}`));
  }
  async runBulkValidation(root, scope, opts) {
    const spinner = !opts.json && !opts.noInteractive ? ora("\u6B63\u5728\u9A8C\u8BC1...").start() : void 0;
    const [changeIds, specIds] = await Promise.all([
      scope.changes ? this.listChangeIds(root) : Promise.resolve([]),
      scope.specs ? getSpecIds(root.path) : Promise.resolve([])
    ]);
    const DEFAULT_CONCURRENCY = 6;
    const maxSuggestions = 5;
    const concurrency = normalizeConcurrency(opts.concurrency) ?? normalizeConcurrency(process.env.OPENSPEC_CONCURRENCY) ?? DEFAULT_CONCURRENCY;
    const validator = new Validator(opts.strict);
    const queue = [];
    for (const id of changeIds) {
      queue.push(async () => {
        const start = Date.now();
        const changeDir = import_path12.default.join(root.changesDir, id);
        const report = await validator.validateChangeDeltaSpecs(changeDir, {
          mainSpecsDir: root.specsDir,
          projectRoot: root.path
        });
        const durationMs = Date.now() - start;
        return { id, type: "change", valid: report.valid, issues: report.issues, durationMs };
      });
    }
    for (const id of specIds) {
      queue.push(async () => {
        const start = Date.now();
        const file2 = import_path12.default.join(root.specsDir, id, "spec.md");
        const report = await validator.validateSpec(file2);
        const durationMs = Date.now() - start;
        return { id, type: "spec", valid: report.valid, issues: report.issues, durationMs };
      });
    }
    if (queue.length === 0) {
      spinner?.stop();
      const summary2 = {
        totals: { items: 0, passed: 0, failed: 0 },
        byType: {
          ...scope.changes ? { change: { items: 0, passed: 0, failed: 0 } } : {},
          ...scope.specs ? { spec: { items: 0, passed: 0, failed: 0 } } : {}
        }
      };
      if (opts.json) {
        const out = { items: [], summary: summary2, version: "1.0", root: toRootOutput(root) };
        console.log(JSON.stringify(out, null, 2));
      } else {
        console.log("\u672A\u627E\u5230\u8981\u9A8C\u8BC1\u7684\u9879\u76EE\u3002");
      }
      process.exitCode = 0;
      return;
    }
    const results = [];
    let index = 0;
    let running = 0;
    let passed = 0;
    let failed = 0;
    await new Promise((resolve4) => {
      const next = () => {
        while (running < concurrency && index < queue.length) {
          const currentIndex = index++;
          const task = queue[currentIndex];
          running++;
          if (spinner) spinner.text = `\u6B63\u5728\u9A8C\u8BC1 (${currentIndex + 1}/${queue.length})...`;
          task().then((res) => {
            results.push(res);
            if (res.valid) passed++;
            else failed++;
          }).catch((error52) => {
            const message = error52?.message || "\u672A\u77E5\u9519\u8BEF";
            const res = { id: getPlannedId(currentIndex, changeIds, specIds) ?? "unknown", type: getPlannedType(currentIndex, changeIds, specIds) ?? "change", valid: false, issues: [{ level: "ERROR", path: "file", message }], durationMs: 0 };
            results.push(res);
            failed++;
          }).finally(() => {
            running--;
            if (index >= queue.length && running === 0) resolve4();
            else next();
          });
        }
      };
      next();
    });
    spinner?.stop();
    results.sort((a, b) => a.id.localeCompare(b.id));
    const summary = {
      totals: { items: results.length, passed, failed },
      byType: {
        ...scope.changes ? { change: summarizeType(results, "change") } : {},
        ...scope.specs ? { spec: summarizeType(results, "spec") } : {}
      }
    };
    if (opts.json) {
      const out = { items: results, summary, version: "1.0", root: toRootOutput(root) };
      console.log(JSON.stringify(out, null, 2));
    } else {
      for (const res of results) {
        if (res.valid) console.log(`\u2713 ${res.type}/${res.id}`);
        else console.error(`\u2717 ${res.type}/${res.id}`);
      }
      console.log(`\u6C47\u603B\uFF1A\u901A\u8FC7 ${summary.totals.passed} \u9879\uFF0C\u5931\u8D25 ${summary.totals.failed} \u9879\uFF08\u5171 ${summary.totals.items} \u9879\uFF09`);
      const firstFailure = results.find((res) => !res.valid);
      if (firstFailure) {
        const storeFlag = isStoreSelectedRoot(root) ? ` --store ${root.storeId}` : "";
        console.log(
          `\u8BE6\u60C5\uFF1Aspect validate ${firstFailure.id} --type ${firstFailure.type}${storeFlag}`
        );
      }
    }
    process.exitCode = failed > 0 ? 1 : 0;
  }
  /**
   * Lists archived change ids from the resolved root's archive directory,
   * mirroring `getArchivedChangeIds` but store-aware (uses `root.archiveDir`
   * rather than a cwd-relative path). Directories only, hidden entries skipped.
   *
   * Only a missing archive directory (ENOENT) is an empty list; a permission
   * error, an I/O error, or an `archive` path that is a file (ENOTDIR) is a real
   * failure and must not read as "no archived changes" — that would let a
   * pre-commit lint pass without inspecting anything (#205).
   */
  async listArchivedChangeIds(root) {
    try {
      const entries = await import_fs12.promises.readdir(root.archiveDir, { withFileTypes: true });
      return entries.filter((entry) => entry.isDirectory() && !entry.name.startsWith(".")).map((entry) => entry.name).sort();
    } catch (error52) {
      if (error52?.code === "ENOENT") return [];
      throw error52;
    }
  }
  /**
   * Validates that every archived change has all of its tasks completed.
   *
   * An archived change is expected to be finished; an archived change with
   * unchecked tasks is a real integrity problem the normal validate flow never
   * surfaces, because active-change discovery excludes the archive directory
   * (#205). Reuses the same task-progress counting `status`, `list`, and
   * `archive` rely on, so what counts as a task never forks. Changes with no
   * tasks pass (nothing to complete).
   */
  async runArchivedTaskValidation(root, opts) {
    const ids = await this.listArchivedChangeIds(root);
    const spinner = !opts.json && !opts.noInteractive ? ora("Validating archived changes...").start() : void 0;
    const schemaGlobCache = /* @__PURE__ */ new Map();
    const results = [];
    let passed = 0;
    let failed = 0;
    for (const id of ids) {
      const start = Date.now();
      const issues = [];
      try {
        const progress = await getTaskProgressDetailForChange(root.archiveDir, id, root.path, schemaGlobCache);
        for (const file2 of progress.unreadable) {
          issues.push({
            level: "ERROR",
            path: FileSystemUtils.toPosixPath(import_path12.default.relative(root.path, file2)),
            message: "could not read task file"
          });
        }
        const incomplete = Math.max(progress.total - progress.completed, 0);
        if (incomplete > 0) {
          issues.push({
            level: "ERROR",
            path: "tasks.md",
            message: `${incomplete} incomplete task${incomplete === 1 ? "" : "s"} (${progress.completed}/${progress.total} completed)`
          });
        }
      } catch (error52) {
        issues.push({ level: "ERROR", path: "tasks.md", message: error52?.message || "Unknown error" });
      }
      const valid = issues.length === 0;
      if (valid) passed++;
      else failed++;
      results.push({ id, type: "change", valid, issues, durationMs: Date.now() - start });
    }
    spinner?.stop();
    const summary = {
      totals: { items: results.length, passed, failed },
      byType: { change: summarizeType(results, "change") }
    };
    if (opts.json) {
      const out = { items: results, summary, version: "1.0", root: toRootOutput(root) };
      console.log(JSON.stringify(out, null, 2));
      process.exitCode = failed > 0 ? 1 : 0;
      return;
    }
    if (results.length === 0) {
      console.log("No archived changes found.");
      process.exitCode = 0;
      return;
    }
    for (const res of results) {
      if (res.valid) {
        console.log(`\u2713 change/${res.id}`);
      } else {
        console.error(`\u2717 change/${res.id}`);
        for (const issue2 of res.issues) {
          const prefix = issue2.level === "ERROR" ? "\u2717" : issue2.level === "WARNING" ? "\u26A0" : "\u2139";
          console.error(`  ${prefix} ${issue2.message}`);
        }
      }
    }
    console.log(`Totals: ${summary.totals.passed} passed, ${summary.totals.failed} failed (${summary.totals.items} items)`);
    process.exitCode = failed > 0 ? 1 : 0;
  }
};
function summarizeType(results, type) {
  const filtered = results.filter((r) => r.type === type);
  const items = filtered.length;
  const passed = filtered.filter((r) => r.valid).length;
  const failed = items - passed;
  return { items, passed, failed };
}
function normalizeConcurrency(value) {
  if (!value) return void 0;
  const n = parseInt(value, 10);
  if (Number.isNaN(n) || n <= 0) return void 0;
  return n;
}
function getPlannedId(index, changeIds, specIds) {
  const totalChanges = changeIds.length;
  if (index < totalChanges) return changeIds[index];
  const specIndex = index - totalChanges;
  return specIds[specIndex];
}
function getPlannedType(index, changeIds, specIds) {
  const totalChanges = changeIds.length;
  if (index < totalChanges) return "change";
  const specIndex = index - totalChanges;
  if (specIndex >= 0 && specIndex < specIds.length) return "spec";
  return void 0;
}

