      throw blocked();
    }
    throw error52;
  }
}
function toArchiveDiagnostic(error52) {
  if (error52 instanceof ArchiveBlockedError) {
    return error52.diagnostic;
  }
  if (isRootSelectionError(error52)) {
    return error52.diagnostic;
  }
  return {
    severity: "error",
    code: "archive_error",
    message: error52 instanceof Error ? error52.message : String(error52)
  };
}
async function copySymbolicLink(src, dest) {
  const target = await import_fs10.promises.readlink(src);
  const isWindowsDirectoryLink = process.platform === "win32" && (await import_fs10.promises.stat(src)).isDirectory();
  const destinationTarget = isWindowsDirectoryLink && !import_path9.default.isAbsolute(target) ? import_path9.default.resolve(import_path9.default.dirname(src), target) : target;
  await import_fs10.promises.symlink(destinationTarget, dest, isWindowsDirectoryLink ? "junction" : void 0);
}
async function copyDirContents(src, dest) {
  const sourceStat = await import_fs10.promises.lstat(src);
  await import_fs10.promises.chmod(dest, sourceStat.mode & 4095 | 448);
  const entries = await import_fs10.promises.readdir(src, { withFileTypes: true });
  for (const entry of entries) {
    const srcPath = import_path9.default.join(src, entry.name);
    const destPath = import_path9.default.join(dest, entry.name);
    if (entry.isDirectory()) {
      await import_fs10.promises.mkdir(destPath, { mode: 448 });
      await copyDirContents(srcPath, destPath);
    } else if (entry.isSymbolicLink()) {
      await copySymbolicLink(srcPath, destPath);
    } else if (entry.isFile()) {
      await import_fs10.promises.copyFile(srcPath, destPath, import_fs10.constants.COPYFILE_EXCL);
    } else {
      throw new Error(`\u65E0\u6CD5\u5F52\u6863\u4E0D\u53D7\u652F\u6301\u7684\u6587\u4EF6\u7CFB\u7EDF\u6761\u76EE\uFF1A${srcPath}`);
    }
  }
  await import_fs10.promises.chmod(dest, sourceStat.mode & 4095);
}
async function fingerprintDirectoryContents(root) {
  const hash2 = (0, import_crypto2.createHash)("sha256");
  const updateHashField = (label, value) => {
    const labelBuffer = Buffer.from(label);
    const valueBuffer = typeof value === "string" ? Buffer.from(value) : value;
    const lengths = Buffer.allocUnsafe(16);
    lengths.writeBigUInt64BE(BigInt(labelBuffer.length), 0);
    lengths.writeBigUInt64BE(BigInt(valueBuffer.length), 8);
    hash2.update(lengths);
    hash2.update(labelBuffer);
    hash2.update(valueBuffer);
  };
  const fingerprintFile = async (filePath) => {
    const fileHash = (0, import_crypto2.createHash)("sha256");
    for await (const chunk of (0, import_fs10.createReadStream)(filePath)) {
      fileHash.update(chunk);
    }
    return fileHash.digest();
  };
  const visit = async (dir, relativeDir) => {
    const before = await import_fs10.promises.lstat(dir, { bigint: true });
    if (!before.isDirectory()) {
      throw new Error(`\u6821\u9A8C ${dir} \u65F6\u671F\u671B\u662F\u4E00\u4E2A\u76EE\u5F55\u3002`);
    }
    updateHashField("directory-mode", (before.mode & 0o7777n).toString());
    const entries = (await import_fs10.promises.readdir(dir, { withFileTypes: true })).sort(
      (a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0
    );
    for (const entry of entries) {
      const entryPath = import_path9.default.join(dir, entry.name);
      const relativePath = import_path9.default.join(relativeDir, entry.name);
      const stat = await import_fs10.promises.lstat(entryPath, { bigint: true });
      updateHashField("path", relativePath);
      if (stat.isDirectory()) {
        updateHashField("type", "directory");
        await visit(entryPath, relativePath);
      } else if (stat.isSymbolicLink()) {
        const target = await import_fs10.promises.readlink(entryPath);
        const after2 = await import_fs10.promises.lstat(entryPath, { bigint: true });
        if (statIdentity(stat) !== statIdentity(after2)) {
          throw new Error(`archive \u8BFB\u53D6 ${entryPath} \u671F\u95F4\u8DEF\u5F84\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
        }
        updateHashField("type", "symlink");
        updateHashField("target", target);
      } else if (stat.isFile()) {
        const contentFingerprint = await fingerprintFile(entryPath);
        const after2 = await import_fs10.promises.lstat(entryPath, { bigint: true });
        if (statIdentity(stat) !== statIdentity(after2)) {
          throw new Error(`archive \u8BFB\u53D6 ${entryPath} \u671F\u95F4\u8DEF\u5F84\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
        }
        updateHashField("type", "file");
        updateHashField("mode", (stat.mode & 0o7777n).toString());
        updateHashField("content-sha256", contentFingerprint);
      } else {
        updateHashField("type", "other");
        updateHashField("mode", stat.mode.toString());
        updateHashField("size", stat.size.toString());
      }
    }
    const after = await import_fs10.promises.lstat(dir, { bigint: true });
    if (statIdentity(before) !== statIdentity(after)) {
      throw new Error(`archive \u8BFB\u53D6 ${dir} \u671F\u95F4\u76EE\u5F55\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
    }
  };
  await visit(root, "");
  return hash2.digest("hex");
}
async function assertCopiedDirectoryUnchanged(stagedSource, destination, expectedFingerprint) {
  const sourceFingerprint = await fingerprintDirectoryContents(stagedSource);
  const destinationFingerprint = await fingerprintDirectoryContents(destination);
  if (sourceFingerprint !== expectedFingerprint || destinationFingerprint !== expectedFingerprint) {
    throw new Error(
      `\u53D8\u66F4\u76EE\u5F55\u5185\u5BB9\u5728\u4ECE ${stagedSource} \u5230 ${destination} \u7684\u56DE\u9000\u62F7\u8D1D\u671F\u95F4\u53D1\u751F\u4E86\u53D8\u5316\u3002`
    );
  }
}
