      requires: external_exports.array(external_exports.string()).min(1, { error: "\u81F3\u5C11\u9700\u8981\u4E00\u4E2A\u5FC5\u9700\u7684\u4EA7\u51FA\u7269" }),
      // Path to file with checkboxes for progress (relative to change dir), or null if no tracking
