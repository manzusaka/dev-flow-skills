async function isDefinitelyMissing(target) {
  return import_fs14.promises.access(target).then(() => false).catch((error52) => error52?.code === "ENOENT");
}
function isChangeDirectoryName(changesPath, changeDir) {
  return import_path14.default.dirname(import_path14.default.resolve(changeDir)) === import_path14.default.resolve(changesPath);
}
var ChangeCommand = class {
