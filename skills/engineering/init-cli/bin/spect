var import_node_readline = require("node:readline");
function resolveNoInteractive(value) {
  if (typeof value === "boolean") return value;
  return value?.noInteractive === true || value?.interactive === false;
}
function isInteractive2(value) {
  if (resolveNoInteractive(value)) return false;
  if (process.env.OPEN_SPEC_INTERACTIVE === "0") return false;
  if ("CI" in process.env) return false;
  return !!process.stdin.isTTY;
}
function isNonInteractivePromptError(error52, value) {
  if (!(error52 instanceof Error)) return false;
  const failedPrompt = error52.name === "ExitPromptError" || error52.message.includes("force closed the prompt");
  if (!failedPrompt) return false;
  if (error52.message.includes("SIGINT")) return false;
  return !isInteractive2(value) || !process.stdout.isTTY;
}
async function confirmPrompt(prompt, io = {}) {
  const input = io.input ?? process.stdin;
  const output = io.output ?? process.stdout;
  const isTerminal = Boolean(input.isTTY) && Boolean(output.isTTY);
  if (isTerminal) {
    const { confirm } = await Promise.resolve().then(() => (init_esm15(), esm_exports));
    return confirm(prompt);
  }
  return readYesNo(prompt, input, output);
}
function readYesNo(prompt, input, output) {
  return new Promise((resolve4, reject) => {
    let settled = false;
    const cleanup = () => {
      input.removeListener("error", onError);
    };
    const blockOnNoAnswer = () => {
      if (settled) return;
      settled = true;
      cleanup();
      const error52 = new Error("User force closed the prompt");
      error52.name = "ExitPromptError";
      reject(error52);
    };
    const onError = (err) => {
      if (settled) return;
      settled = true;
      cleanup();
      rl.close();
      reject(err instanceof Error ? err : new Error(String(err)));
    };
    if (input.readableEnded) {
      blockOnNoAnswer();
      return;
    }
    output.write(`${prompt.message} ${prompt.default ? "(Y/n)" : "(y/N)"} `);
    const rl = (0, import_node_readline.createInterface)({ input, terminal: false });
    input.once("error", onError);
    rl.once("error", onError);
    rl.once("line", (line) => {
      if (settled) return;
      settled = true;
      cleanup();
      rl.close();
      output.write("\n");
      const answer = line.trim();
      if (/^(y|yes)/i.test(answer)) {
        resolve4(true);
      } else if (/^(n|no)/i.test(answer)) {
        resolve4(false);
      } else {
        resolve4(prompt.default);
      }
    });
    rl.once("close", () => {
      blockOnNoAnswer();
    });
  });
}

