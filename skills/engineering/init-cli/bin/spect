async function releaseArchiveClaim(claim, claimPath) {
  const owned = await claim.handle.stat({ bigint: true }).catch(() => void 0);
  await claim.handle.close().catch(() => void 0);
  if (owned === void 0) return;
  try {
    const current = await import_fs10.promises.lstat(claimPath, { bigint: true });
    const contents = await import_fs10.promises.readFile(claimPath, "utf8");
    const currentAfterRead = await import_fs10.promises.lstat(claimPath, { bigint: true });
    if (current.dev === owned.dev && current.ino === owned.ino && current.dev === currentAfterRead.dev && current.ino === currentAfterRead.ino && contents === claim.contents) {
      await import_fs10.promises.unlink(claimPath);
    }
  } catch (error52) {
    if (error52.code !== "ENOENT") throw error52;
  }
}
async function claimArchiveDestination(archivePath, archiveName) {
  const claimPath = archiveClaimPath(archivePath, archiveName);
  try {
    const handle = await import_fs10.promises.open(claimPath, "wx");
    const claim = {
      handle,
      contents: JSON.stringify({ pid: process.pid, nonce: (0, import_crypto2.randomUUID)() })
    };
    try {
      await handle.writeFile(claim.contents);
      await handle.sync();
      return claim;
    } catch (error52) {
      await releaseArchiveClaim(claim, claimPath).catch(() => void 0);
      throw error52;
    }
  } catch (error52) {
    if (error52.code === "EEXIST") {
      throw new ArchiveBlockedError(
        "archive_target_exists",
        `\u5F52\u6863 '${archiveName}' \u6B63\u5728\u521B\u5EFA\u4E2D\u3002\u5982\u679C\u6CA1\u6709\u6B63\u5728\u8FD0\u884C\u7684\u5F52\u6863\u8FDB\u7A0B\uFF0C\u8BF7\u5220\u9664 ${claimPath} \u5904\u6B8B\u7559\u7684\u9501\u6587\u4EF6\u540E\u91CD\u65B0\u8FD0\u884C\u3002`
      );
    }
    throw error52;
  }
