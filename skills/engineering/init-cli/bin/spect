function folderStyleNameProblem(value, label) {
  if (value.length === 0) {
    return `${label}\u4E0D\u80FD\u4E3A\u7A7A`;
  }
  if (value === "." || value === "..") {
    return `${label}\u4E0D\u80FD\u662F '${value}'`;
  }
  if (/[\\/]/u.test(value)) {
    return `${label}\u4E0D\u80FD\u5305\u542B\u8DEF\u5F84\u5206\u9694\u7B26`;
  }
  return null;
}
