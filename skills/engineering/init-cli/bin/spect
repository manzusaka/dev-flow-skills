      return `missing:${import_path9.default.join(realParent, import_path9.default.basename(mutation.update.target))}`;
    }
    throw error52;
  }
}
async function assertDistinctMutationTargets(mutations) {
  const owners = /* @__PURE__ */ new Map();
  for (const mutation of mutations) {
    const identity = await mutationTargetIdentity(mutation);
    const existing = owners.get(identity);
    if (existing !== void 0) {
      throw new Error(
        `'${existing}' \u4E0E '${mutation.update.id}' \u7684 spec \u66F4\u65B0\u89E3\u6790\u5230\u4E86\u540C\u4E00\u4E2A\u76EE\u6807 ${identity}\u3002\u8BF7\u5728\u5F52\u6863\u524D\u66FF\u6362\u8BE5\u529F\u80FD\u522B\u540D\uFF0C\u6216\u5C06\u8FD9\u4E9B delta \u5408\u5E76\u3002`
      );
    }
    owners.set(identity, mutation.update.id);
  }
