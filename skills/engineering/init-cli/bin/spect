    init_zod();
    ArtifactSchema = external_exports.object({
      id: external_exports.string().min(1, { error: "Artifact ID is required" }),
      generates: relativePathSchema("generates field"),
      description: external_exports.string(),
      template: relativePathSchema("template field"),
      instruction: external_exports.string().optional(),
      requires: external_exports.array(external_exports.string()).default([])
    });
    ImplementPhaseSchema = external_exports.object({
