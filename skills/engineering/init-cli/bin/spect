async function moveDirectory(src, dest, options = {}) {
  try {
    await import_fs10.promises.rename(src, dest);
  } catch (err) {
    const code = err?.code;
    if (code === "ENOTEMPTY" || code === "EEXIST") {
      throw new ArchiveBlockedError(
        "archive_target_exists",
        `\u5F52\u6863 '${import_path9.default.basename(dest)}' \u5DF2\u5B58\u5728\u3002`
      );
    }
    if (code === "EPERM" || code === "EXDEV") {
      const stagedSource = import_path9.default.join(import_path9.default.dirname(src), `.openspec-move-${(0, import_crypto2.randomUUID)()}`);
      try {
        await import_fs10.promises.rename(src, stagedSource);
      } catch (stageError) {
        throw new Error(
          `\u5728\u56DE\u9000\u5F52\u6863\u62F7\u8D1D\u4E4B\u524D\u65E0\u6CD5\u5B89\u5168\u6682\u5B58 ${src} \uFF08${stageError instanceof Error ? stageError.message : String(stageError)}\uFF09\u3002\u672A\u5C1D\u8BD5\u8FDB\u884C\u56DE\u9000\u62F7\u8D1D\u3002`
        );
      }
      let destIsOurs = false;
      let stagedFingerprint;
      try {
        stagedFingerprint = await fingerprintDirectoryContents(stagedSource);
        await import_fs10.promises.mkdir(dest, { mode: 448 });
        destIsOurs = true;
        await copyDirContents(stagedSource, dest);
        await options.verifyCopiedDestination?.(stagedSource);
        await assertCopiedDirectoryUnchanged(stagedSource, dest, stagedFingerprint);
      } catch (copyError) {
        if (destIsOurs) {
          await import_fs10.promises.rm(dest, { recursive: true, force: true }).catch(() => void 0);
        }
        try {
          await import_fs10.promises.rename(stagedSource, src);
        } catch (restoreError) {
          throw new Error(
            couldNotRestoreStagedSourceMessage(copyError, stagedSource, restoreError)
          );
        }
        if (copyError.code === "EEXIST") {
          throw new ArchiveBlockedError(
            "archive_target_exists",
            `\u5F52\u6863 '${import_path9.default.basename(dest)}' \u5DF2\u5B58\u5728\u3002`
          );
        }
        throw copyError;
      }
      try {
        await options.verifyCopiedDestination?.(stagedSource);
        await assertCopiedDirectoryUnchanged(stagedSource, dest, stagedFingerprint);
      } catch (verificationError) {
        await import_fs10.promises.rm(dest, { recursive: true, force: true }).catch(() => void 0);
        try {
          await import_fs10.promises.rename(stagedSource, src);
        } catch (restoreError) {
          throw new Error(
            couldNotRestoreStagedSourceMessage(verificationError, stagedSource, restoreError)
          );
        }
        throw verificationError;
      }
      try {
        await import_fs10.promises.rm(stagedSource, { recursive: true, force: true });
      } catch (cleanupError) {
        throw new MoveDestinationRetainedError(
          `\u5DF2\u5C06 ${src} \u62F7\u8D1D\u5230 ${dest}\uFF0C\u4F46\u65E0\u6CD5\u5B8C\u6574\u5220\u9664\u4F4D\u4E8E ${stagedSource} \u7684\u6682\u5B58\u6E90\u76EE\u5F55\uFF08${cleanupError instanceof Error ? cleanupError.message : String(cleanupError)}\uFF09\u3002\u5DF2\u4FDD\u7559\u5B8C\u6574\u7684\u76EE\u6807\u76EE\u5F55\u4EE5\u4FBF\u6062\u590D\u3002`
        );
      }
    } else {
      throw err;
    }
  }
}
