newCmd.command("change <name>").description("\u521B\u5EFA\u65B0\u7684\u53D8\u66F4\u76EE\u5F55").option("--description <text>", "\u6DFB\u52A0\u5230 README.md \u7684\u63CF\u8FF0").option("--goal <text>", "\u968F\u53D8\u66F4\u5B58\u50A8\u7684\u53EF\u9009\u76EE\u6807\u5143\u6570\u636E").option("--schema <name>", `\u8981\u4F7F\u7528\u7684\u5DE5\u4F5C\u6D41 Schema\uFF08\u9ED8\u8BA4\uFF1A${DEFAULT_SCHEMA}\uFF09`).option("--json", "\u4EE5 JSON \u683C\u5F0F\u8F93\u51FA").action(async (name, options) => {
  try {
    await newChangeCommand(name, options);
  } catch (error52) {
    failWithError(error52);
    process.exit(1);
  }
});
function runCli(argv = process.argv) {
  program2.parse(argv);
}
