          return `${base}\uFF0C\u4E14\u9700\u51FA\u73B0\u5728\u9700\u6C42\u6B63\u6587\u4E2D\uFF0C\u800C\u4E0D\u662F\u53EA\u51FA\u73B0\u5728\u6807\u9898\u91CC\u3002\u8BF7\u628A SHALL/MUST \u8BED\u53E5\u79FB\u5230 "### Requirement: ..." \u6807\u9898\u7684\u4E0B\u4E00\u884C\u3002${suffix}`;
        }
        return `${base}${suffix}`;
      }
      countScenarios(blockRaw) {
