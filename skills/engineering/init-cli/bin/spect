      warnings.push(
        `rules \u4E2D\u5B58\u5728\u672A\u77E5\u7684\u5236\u54C1 ID\uFF1A"${artifactId}"\u3002\u5B83\u4E0E\u4EFB\u4F55\u53EF\u7528 schema \u4E2D\u7684\u5236\u54C1\u90FD\u4E0D\u5339\u914D\u3002\u5DF2\u77E5\u7684\u5236\u54C1 ID\uFF1A${validIds}`
      );
    }
