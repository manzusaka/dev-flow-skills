        }
      }
    }
  }
  async validate(changeName, options) {
    const changesPath = import_path14.default.join(process.cwd(), "openspec", "changes");
    if (!changeName) {
      const canPrompt = isInteractive2(options);
      const changes = await getActiveChangeIds();
      if (canPrompt && changes.length > 0) {
        const { select } = await Promise.resolve().then(() => (init_esm15(), esm_exports));
        const selected = await select({
          message: "\u9009\u62E9\u4E00\u4E2A\u53D8\u66F4\u4EE5\u9A8C\u8BC1",
          choices: changes.map((id) => ({ name: id, value: id }))
