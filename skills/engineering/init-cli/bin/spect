    init_CreateFileError();
    init_LaunchEditorError();
    init_ReadFileError();
    init_RemoveFileError();
    ExternalEditor = class {
      text = "";
      tempFile;
      editor;
      lastExitStatus = 0;
      fileOptions = {};
