function getGlobalDataDir(options = {}) {
  const env2 = options.env ?? process.env;
  const platform2 = options.platform ?? os2.platform();
  const xdgDataHome = env2.XDG_DATA_HOME;
  if (xdgDataHome) {
    return joinGlobalDataPath(platform2, xdgDataHome, GLOBAL_DATA_DIR_NAME);
  }
  const homedir2 = options.homedir ?? os2.homedir();
  if (platform2 === "win32") {
    const localAppData = env2.LOCALAPPDATA;
    if (localAppData) {
      return joinGlobalDataPath(platform2, localAppData, GLOBAL_DATA_DIR_NAME);
    }
    return joinGlobalDataPath(platform2, homedir2, "AppData", "Local", GLOBAL_DATA_DIR_NAME);
