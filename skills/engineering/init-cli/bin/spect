    );
  }
  const hasAnyDelta = plan.added.length + plan.modified.length + plan.removed.length + plan.renamed.length > 0;
  if (!hasAnyDelta) {
    throw new Error(
      `Delta \u89E3\u6790\u672A\u627E\u5230 ${update.id} \u7684\u64CD\u4F5C\u3002\u8BF7\u5728 change spec \u4E2D\u63D0\u4F9B ADDED/MODIFIED/REMOVED/RENAMED \u7AE0\u8282\u3002`
