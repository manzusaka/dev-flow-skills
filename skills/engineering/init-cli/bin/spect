function validateSchemaName(schemaName, projectRoot) {
  const availableSchemas = listSchemas(projectRoot);
  if (!availableSchemas.includes(schemaName)) {
    throw new Error(
      `\u672A\u77E5 schema '${schemaName}'\u3002\u53EF\u7528\uFF1A${availableSchemas.join(", ")}`
    );
  }
  return schemaName;
}
function writeChangeMetadata(changeDir, metadata, projectRoot) {
