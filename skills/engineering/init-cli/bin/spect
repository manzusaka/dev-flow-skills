function failWithError(error52, json2) {
  if (json2?.enabled) {
    console.log(
      JSON.stringify(
        { ...json2.payload ?? {}, status: [asStatus(error52, json2.fallbackCode ?? "command_error")] },
        null,
        2
      )
    );
    process.exitCode = 1;
    return;
  }
  ora().fail(`Error: ${error52.message}`);
  const fix = error52.diagnostic?.fix;
  if (fix) {
    console.error(`\u4FEE\u590D\uFF1A${fix}`);
  }
  process.exitCode = process.exitCode ?? 1;
}
