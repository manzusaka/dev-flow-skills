async function createPlan(projectRoot) {
  const openspecDir = import_node_path2.default.join(projectRoot, "openspec");
  const configYamlPath = import_node_path2.default.join(openspecDir, "config.yaml");
  const hasConfigYaml = await pathExists(configYamlPath);
  const files = [];
  const configContent = hasConfigYaml ? await import_node_fs.promises.readFile(configYamlPath, "utf8") : EMBEDDED_CONFIG_YAML;
  if (!hasConfigYaml) {
    files.push({ relativePath: "config.yaml", content: EMBEDDED_CONFIG_YAML });
  }
  const config2 = parseProjectConfigStrict(configContent);
  const schemaCandidate = await resolveSchemaCandidate(projectRoot, config2.schema, files);
  const schema = parseSchema(schemaCandidate.content);
  await validateTemplates(schema, schemaCandidate.directory, schemaCandidate.embedded, openspecDir, files);
  await validateExistingArtifacts(projectRoot, files);
  return {
    openspecDir,
    files,
    keepDirs: [import_node_path2.default.join("specs"), import_node_path2.default.join("changes", "archive")]
  };
}
async function validateExistingArtifacts(projectRoot, plannedFiles) {
  let validationRoot = projectRoot;
  let temporaryRoot = null;
  try {
    if (plannedFiles.length > 0) {
      temporaryRoot = await import_node_fs.promises.mkdtemp(import_node_path2.default.join(import_node_os3.default.tmpdir(), "spect-init-validate-"));
      validationRoot = temporaryRoot;
      const sourceOpenSpec = import_node_path2.default.join(projectRoot, "openspec");
      const stagedOpenSpec = import_node_path2.default.join(validationRoot, "openspec");
      if (await pathExists(sourceOpenSpec)) {
        await import_node_fs.promises.cp(sourceOpenSpec, stagedOpenSpec, { recursive: true });
      }
      for (const file2 of plannedFiles) {
        const target = import_node_path2.default.join(stagedOpenSpec, file2.relativePath);
        if (!await pathExists(target)) {
          await import_node_fs.promises.mkdir(import_node_path2.default.dirname(target), { recursive: true });
          await import_node_fs.promises.writeFile(target, file2.content, "utf8");
        }
      }
    }
    const [changeIds, specIds] = await Promise.all([
      getActiveChangeIds(validationRoot),
      getSpecIds(validationRoot)
    ]);
    if (changeIds.length === 0 && specIds.length === 0) {
      return;
    }
    const validator = new Validator(true);
    const failures = [];
    for (const changeId of changeIds) {
      const report = await validator.validateChangeDeltaSpecs(
        import_node_path2.default.join(validationRoot, "openspec", "changes", changeId),
        {
          mainSpecsDir: import_node_path2.default.join(validationRoot, "openspec", "specs"),
          projectRoot: validationRoot
        }
      );
      if (!report.valid) failures.push(`change/${changeId}`);
    }
    for (const specId of specIds) {
      const report = await validator.validateSpec(
        import_node_path2.default.join(validationRoot, "openspec", "specs", specId, "spec.md")
      );
      if (!report.valid) failures.push(`spec/${specId}`);
    }
    if (failures.length > 0) {
      throw new Error(`Existing OpenSpec artifacts are invalid: ${failures.join(", ")}`);
    }
  } finally {
    if (temporaryRoot) {
      await import_node_fs.promises.rm(temporaryRoot, { recursive: true, force: true });
    }
  }
}
async function resolveSchemaCandidate(projectRoot, schemaName, files) {
  const schemasDir = import_node_path2.default.join(projectRoot, "openspec", "schemas");
  if (schemaName === DEFAULT_SCHEMA3) {
    const namedSchema = import_node_path2.default.join(schemasDir, schemaName, "schema.yaml");
    const flatSchema = import_node_path2.default.join(schemasDir, "schema.yaml");
    for (const schemaPath of [namedSchema, flatSchema]) {
      if (await pathExists(schemaPath)) {
        return {
          content: await import_node_fs.promises.readFile(schemaPath, "utf8"),
          directory: import_node_path2.default.dirname(schemaPath),
          embedded: false
        };
      }
    }
    files.push({ relativePath: import_node_path2.default.join("schemas", "schema.yaml"), content: EMBEDDED_SCHEMA_YAML });
    return { content: EMBEDDED_SCHEMA_YAML, directory: null, embedded: true };
  }
  const schemaDir = getSchemaDir(schemaName, projectRoot);
  if (!schemaDir) {
    throw new Error(`Schema '${schemaName}' not found for openspec config`);
  }
  return {
    content: await import_node_fs.promises.readFile(import_node_path2.default.join(schemaDir, "schema.yaml"), "utf8"),
    directory: schemaDir,
    embedded: false
  };
}
async function validateTemplates(schema, schemaDirectory, embedded, openspecDir, files) {
  for (const artifact of schema.artifacts) {
    if (embedded) {
      const templateName = artifact.template.replace(/\.md$/u, "");
      const content = EMBEDDED_TEMPLATES[templateName];
      if (content === void 0) {
        throw new Error(`Embedded template is missing: ${artifact.template}`);
      }
      const relativePath = import_node_path2.default.join("schemas", "templates", artifact.template);
      const targetPath = import_node_path2.default.join(openspecDir, relativePath);
      if (await pathExists(targetPath)) {
        if (!await isFile(targetPath)) {
          throw new Error(`Template path is not a file: ${artifact.template}`);
        }
      } else {
        files.push({ relativePath, content });
      }
      continue;
    }
    if (!schemaDirectory) {
      throw new Error("Schema directory is unavailable");
    }
    const templatesDir = import_node_path2.default.join(schemaDirectory, "templates");
    const templatePath = import_node_path2.default.resolve(templatesDir, artifact.template);
    if (!isWithin(templatesDir, templatePath) || !await isFile(templatePath)) {
      throw new Error(`Template '${artifact.template}' is missing for schema '${schema.name}'`);
    }
  }
}
function isWithin(rootPath, targetPath) {
  const relative2 = import_node_path2.default.relative(rootPath, targetPath);
  return relative2 === "" || !relative2.startsWith(`..${import_node_path2.default.sep}`) && relative2 !== ".." && !import_node_path2.default.isAbsolute(relative2);
}
async function isFile(targetPath) {
  try {
    return (await import_node_fs.promises.stat(targetPath)).isFile();
  } catch (error52) {
    if (error52.code === "ENOENT") return false;
    throw error52;
  }
}
async function pathExists(targetPath) {
  try {
    await import_node_fs.promises.access(targetPath);
    return true;
  } catch (error52) {
    if (error52.code === "ENOENT") return false;
    throw error52;
  }
}
async function ensureDirectory(targetPath, boundary, createdDirs) {
  const missing = [];
  let current = targetPath;
  while (isWithin(boundary, current) && !await pathExists(current)) {
    missing.push(current);
    if (current === boundary) break;
    current = import_node_path2.default.dirname(current);
  }
  await import_node_fs.promises.mkdir(targetPath, { recursive: true });
  createdDirs.push(...missing.reverse());
}
async function rollbackCreatedPaths(createdFiles, createdDirs) {
  for (const filePath of createdFiles.reverse()) {
    await import_node_fs.promises.rm(filePath, { force: true });
  }
  for (const dirPath of createdDirs.sort((a, b) => b.length - a.length)) {
    try {
      await import_node_fs.promises.rmdir(dirPath);
    } catch (error52) {
      const code = error52.code;
      if (code !== "ENOENT" && code !== "ENOTEMPTY") throw error52;
    }
  }
}
