async function getActiveChangeIds(root = process.cwd()) {
  const changesPath = import_path10.default.join(root, "openspec", "changes");
  try {
    const entries = await import_fs11.promises.readdir(changesPath, { withFileTypes: true });
    return entries.filter((entry) => entry.isDirectory() && entry.name !== "archive" && !entry.name.startsWith(".")).map((entry) => entry.name).sort();
  } catch {
    return [];
  }
}
async function getSpecIds(root = process.cwd()) {
  const specsPath = import_path10.default.join(root, "openspec", "specs");
  const discovered = await discoverSpecFiles(specsPath);
  return discovered.map((spec) => spec.id);
}
