function printOperationInputsText(inputs) {
  if (inputs.context) {
    console.log("### \u9879\u76EE\u4E0A\u4E0B\u6587\uFF08\u5FC5\u586B\u7684\u6307\u4EE4\u8F93\u5165\uFF09");
    console.log(inputs.context);
    console.log();
  }
  if (inputs.operationGuidance && inputs.operationGuidance.length > 0) {
    console.log("### \u64CD\u4F5C\u6307\u5F15\uFF08\u5EFA\u8BAE\u6027\uFF09");
    for (const guidance of inputs.operationGuidance) {
      console.log(`- ${guidance}`);
    }
    console.log();
  }
  if (!inputs.context && !inputs.operationGuidance) {
    console.log("\u672A\u914D\u7F6E\u9879\u76EE\u4E0A\u4E0B\u6587\u6216\u64CD\u4F5C\u6307\u5357\u3002");
  }
}

// src/commands/workflow/templates.ts
var import_path17 = __toESM(require("path"), 1);
init_artifact_graph();
init_file_system();
async function templatesCommand(options) {
  const spinner = options.json ? void 0 : ora("\u6B63\u5728\u52A0\u8F7D\u6A21\u677F...").start();
  try {
    const projectRoot = process.cwd();
    const schemaName = validateSchemaExists(options.schema ?? DEFAULT_SCHEMA, projectRoot);
    const schema = resolveSchema(schemaName, projectRoot);
    const graph = ArtifactGraph.fromSchema(schema);
    const schemaDir = getSchemaDir(schemaName, projectRoot);
    const {
      getUserSchemasDir: getUserSchemasDir2,
      getProjectSchemasDir: getProjectSchemasDir2
    } = await Promise.resolve().then(() => (init_resolver(), resolver_exports));
    const projectSchemasDir = getProjectSchemasDir2(projectRoot);
    const userSchemasDir = getUserSchemasDir2();
    const isInsideDir = (child, parent) => {
      const relative2 = import_path17.default.relative(parent, child);
      return !relative2.startsWith("..") && !import_path17.default.isAbsolute(relative2);
    };
    let source;
    if (isInsideDir(schemaDir, projectSchemasDir)) {
      source = "project";
    } else if (isInsideDir(schemaDir, userSchemasDir)) {
      source = "user";
    } else {
      source = "package";
    }
    const templatesDir = import_path17.default.join(schemaDir, "templates");
    const templates = graph.getAllArtifacts().map((artifact) => {
      const templatePath = import_path17.default.join(templatesDir, artifact.template);
      try {
        FileSystemUtils.assertPathWithin(templatesDir, templatePath);
        return {
          artifactId: artifact.id,
          templatePath: FileSystemUtils.canonicalizeExistingPath(templatePath),
          source
        };
      } catch {
        throw new Error(
          `Template '${artifact.template}' for artifact '${artifact.id}' points outside the schema templates directory`
        );
      }
    });
    spinner?.stop();
    if (options.json) {
      const output = {};
      for (const t of templates) {
        output[t.artifactId] = { path: t.templatePath, source: t.source };
      }
      console.log(JSON.stringify(output, null, 2));
      return;
    }
    console.log(`Schema\uFF1A${schemaName}`);
    console.log(`\u6765\u6E90\uFF1A${source}`);
    console.log();
    for (const t of templates) {
      console.log(`${t.artifactId}:`);
      console.log(`  ${t.templatePath}`);
    }
  } catch (error52) {
    spinner?.stop();
    throw error52;
  }
}

// src/commands/workflow/schemas.ts
