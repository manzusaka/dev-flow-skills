  const searchStart = getSearchStartDirectory(startPath);
  const repoRoot = findRepoPlanningRootSync(searchStart);
  if (repoRoot) {
    return repoPlanningHome(repoRoot);
  }
  if (options.allowImplicitRepoRoot === false) {
    throw new Error("\u5728\u5F53\u524D\u76EE\u5F55\u4E2D\u672A\u627E\u5230 OpenSpec \u89C4\u5212\u4E3B\u76EE\u5F55\u3002");
  }
  return repoPlanningHome(FileSystemUtils.canonicalizeExistingPath(searchStart));
}
function getChangeDir(planningHome, changeName) {
  return FileSystemUtils.joinPath(planningHome.changesDir, changeName);
}
function formatChangeLocation(planningHome, changeName) {
  return path14.relative(planningHome.root, getChangeDir(planningHome, changeName));
}

// src/core/root-selection.ts
init_project_config();
init_file_system();
var RootSelectionError = class extends Error {
  diagnostic;
  constructor(message, code, options = {}) {
    super(message);
    this.name = "RootSelectionError";
    this.diagnostic = {
      severity: "error",
      code,
      message,
      ...options
    };
  }
};
function isRootSelectionError(error52) {
  return error52 instanceof RootSelectionError;
}
function makeRoot(rootPath, source) {
  return {
    path: rootPath,
    changesDir: path15.join(rootPath, "openspec", "changes"),
    specsDir: path15.join(rootPath, "openspec", "specs"),
    archiveDir: path15.join(rootPath, "openspec", "changes", "archive"),
    defaultSchema: "spec-driven",
    source
  };
}
function canonicalDirectory(startPath) {
  const resolved = path15.resolve(startPath);
  try {
    const stats = fs14.statSync(resolved);
    const dir = stats.isDirectory() ? resolved : path15.dirname(resolved);
    return FileSystemUtils.canonicalizeExistingPath(dir);
  } catch {
    return resolved;
  }
}
function findQualifyingRootSync(startPath) {
  let candidate = findRepoPlanningRootSync(startPath);
  while (candidate) {
    const { hasPlanningShape, pointer } = classifyOpenSpecDir(candidate);
    if (hasPlanningShape || pointer.filePath) {
      return candidate;
    }
    const parent = path15.dirname(candidate);
    if (parent === candidate) {
      return null;
    }
    candidate = findRepoPlanningRootSync(parent);
  }
  return null;
}
async function resolveOpenSpecRoot(options = {}) {
  const startPath = options.startPath ?? process.cwd();
  const nearestRoot = findQualifyingRootSync(startPath);
  if (nearestRoot) {
    assertNoLegacyProjectConfig(nearestRoot);
    return makeRoot(nearestRoot, "nearest");
  }
  if (options.allowImplicitRoot === false) {
    throw new RootSelectionError(
      "\u5728\u5F53\u524D\u76EE\u5F55\u4E2D\u672A\u627E\u5230 OpenSpec \u6839\u76EE\u5F55\u3002",
      "no_openspec_root",
      { target: "openspec.root", fix: "\u8FD0\u884C spect init \u5728\u6B64\u521B\u5EFA\u6839\u76EE\u5F55\u3002" }
    );
  }
  return makeRoot(canonicalDirectory(startPath), "implicit");
}
function toRootOutput(root) {
  return {
    path: root.path,
    source: root.source
  };
}
function isStoreSelectedRoot(root) {
  void root;
  return false;
}
function emitStoreRootBanner(root) {
  void root;
}
function withStoreFlag(root, command) {
  void root;
  return command;
}
function toPlanningHome(root) {
  return {
    kind: "repo",
    root: root.path,
    changesDir: root.changesDir,
    defaultSchema: root.defaultSchema
  };
}
async function resolveRootForCommand(selector, output = {}) {
  void selector;
  try {
    return await resolveOpenSpecRoot({
      ...output.allowImplicitRoot !== void 0 ? { allowImplicitRoot: output.allowImplicitRoot } : {}
    });
  } catch (error52) {
    if (output.json && isRootSelectionError(error52)) {
      console.log(
        JSON.stringify(
          { ...output.failurePayload ?? {}, status: [error52.diagnostic] },
          null,
          2
        )
      );
      process.exitCode = 1;
      return null;
    }
    throw error52;
  }
}

// src/core/specs-apply.ts
