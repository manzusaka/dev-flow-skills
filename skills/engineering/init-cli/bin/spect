      async execute(targetPath) {
        const projectRoot = import_node_path2.default.resolve(targetPath);
        const plan = await createPlan(projectRoot);
        const createdFiles = [];
        const createdDirs = [];
        let created = 0;
        try {
          await ensureDirectory(projectRoot, projectRoot, createdDirs);
          for (const file2 of plan.files) {
            const filePath = import_node_path2.default.join(plan.openspecDir, file2.relativePath);
            if (await pathExists(filePath)) {
              console.log(`${source_default.yellow("\u4FDD\u7559")} ${import_node_path2.default.join("openspec", file2.relativePath)}`);
              continue;
            }
            await ensureDirectory(import_node_path2.default.dirname(filePath), projectRoot, createdDirs);
            await import_node_fs.promises.writeFile(filePath, file2.content, { encoding: "utf8", flag: "wx" });
            createdFiles.push(filePath);
            console.log(`${source_default.green("\u521B\u5EFA")} ${import_node_path2.default.join("openspec", file2.relativePath)}`);
            created += 1;
          }
          for (const relativeDir of plan.keepDirs) {
            const dirPath = import_node_path2.default.join(plan.openspecDir, relativeDir);
            await ensureDirectory(dirPath, projectRoot, createdDirs);
            const gitkeep = import_node_path2.default.join(dirPath, ".gitkeep");
            if (!await pathExists(gitkeep)) {
              await import_node_fs.promises.writeFile(gitkeep, "", { encoding: "utf8", flag: "wx" });
              createdFiles.push(gitkeep);
              console.log(`${source_default.green("\u521B\u5EFA")} ${import_node_path2.default.relative(projectRoot, gitkeep)}`);
              created += 1;
            }
          }
        } catch (error52) {
          await rollbackCreatedPaths(createdFiles, createdDirs);
          throw error52;
        }
        console.log("");
        console.log(`OpenSpec \u811A\u624B\u67B6\u5DF2\u5C31\u7EEA\uFF1A${plan.openspecDir}`);
        if (created === 0) {
          console.log("\u6240\u6709\u6587\u4EF6\u5747\u5DF2\u5B58\u5728\uFF0C\u672A\u505A\u4FEE\u6539\u3002");
        }
        console.log("\u4E0B\u4E00\u6B65\uFF1A\u7528 spect new change <name> \u521B\u5EFA\u4F60\u7684\u7B2C\u4E00\u4E2A\u53D8\u66F4\u3002");
      }
    };
  }
});

// src/commands/shared-output.ts
function printJson(payload) {
  console.log(JSON.stringify(payload, null, 2));
}
function asErrorMessage(error52) {
  return error52 instanceof Error ? error52.message : String(error52);
}
function isPromptCancellationError(error52) {
  return error52 instanceof Error && (error52.name === "ExitPromptError" || error52.message.includes("force closed the prompt with SIGINT"));
}
function asStatus(error52, fallbackCode) {
  const diagnostic = error52.diagnostic;
  if (diagnostic && typeof diagnostic.code === "string") {
    return diagnostic;
  }
  return {
    severity: "error",
    code: fallbackCode,
    message: asErrorMessage(error52)
  };
}
function emitFailure(json2, payload, error52, fallbackCode) {
  if (!json2 && isPromptCancellationError(error52)) {
    console.error("\u5DF2\u53D6\u6D88\u3002");
    process.exitCode = 130;
    return;
  }
  const status = asStatus(error52, fallbackCode);
  if (json2) {
    const prior = Array.isArray(payload.status) ? payload.status : [];
    printJson({ ...payload, status: [...prior, status] });
    process.exitCode = 1;
    return;
  }
  console.error(`\u9519\u8BEF\uFF1A${status.message}`);
  if (status.fix) {
    console.error(`\u4FEE\u590D\uFF1A${status.fix}`);
  }
  process.exitCode = 1;
}

