async function fingerprintPath(filePath) {
  try {
    const stat = await import_fs10.promises.lstat(filePath, { bigint: true });
    const digest = async () => (0, import_crypto2.createHash)("sha256").update(await import_fs10.promises.readFile(filePath)).digest("hex");
    if (stat.isSymbolicLink()) {
      const link = await import_fs10.promises.readlink(filePath);
      try {
        const referentBefore = await import_fs10.promises.stat(filePath, { bigint: true });
        const hash2 = await digest();
        const referentAfter = await import_fs10.promises.stat(filePath, { bigint: true });
        const entryAfter = await import_fs10.promises.lstat(filePath, { bigint: true });
        if (statIdentity(stat) !== statIdentity(entryAfter) || statIdentity(referentBefore) !== statIdentity(referentAfter) || link !== await import_fs10.promises.readlink(filePath)) {
          throw new Error(`archive \u8BFB\u53D6 ${filePath} \u671F\u95F4\u8DEF\u5F84\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
        }
        return `symlink:${statIdentity(stat)}:${link}:${statIdentity(referentAfter)}:${hash2}`;
      } catch (error52) {
        if (error52.code === "ENOENT") {
          return `symlink:${statIdentity(stat)}:${link}:missing`;
        }
        throw error52;
      }
    }
    if (stat.isFile()) {
      const hash2 = await digest();
      const after = await import_fs10.promises.lstat(filePath, { bigint: true });
      if (statIdentity(stat) !== statIdentity(after)) {
        throw new Error(`archive \u8BFB\u53D6 ${filePath} \u671F\u95F4\u8DEF\u5F84\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
      }
      return `file:${statIdentity(after)}:${hash2}`;
    }
    return `other:${statIdentity(stat)}`;
  } catch (error52) {
    if (error52.code === "ENOENT") return "missing";
    throw error52;
  }
}
async function fingerprintMovablePath(filePath) {
  try {
    const entry = await import_fs10.promises.lstat(filePath, { bigint: true });
    const hash2 = (0, import_crypto2.createHash)("sha256").update(await import_fs10.promises.readFile(filePath)).digest("hex");
    if (entry.isSymbolicLink()) {
      const link = await import_fs10.promises.readlink(filePath);
      const referent = await import_fs10.promises.stat(filePath, { bigint: true });
      const entryAfter2 = await import_fs10.promises.lstat(filePath, { bigint: true });
      const referentAfter = await import_fs10.promises.stat(filePath, { bigint: true });
      const linkAfter = await import_fs10.promises.readlink(filePath);
      if (statIdentity(entry) !== statIdentity(entryAfter2) || statIdentity(referent) !== statIdentity(referentAfter) || link !== linkAfter) {
        throw new Error(`archive \u8BFB\u53D6 ${filePath} \u671F\u95F4\u8DEF\u5F84\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
      }
      return `symlink:${movableStatIdentity(entry)}:${link}:${movableStatIdentity(referentAfter)}:${hash2}`;
    }
    const entryAfter = await import_fs10.promises.lstat(filePath, { bigint: true });
    if (statIdentity(entry) !== statIdentity(entryAfter)) {
      throw new Error(`archive \u8BFB\u53D6 ${filePath} \u671F\u95F4\u8DEF\u5F84\u53D1\u751F\u4E86\u53D8\u5316\u3002`);
    }
    return `file:${movableStatIdentity(entry)}:${hash2}`;
  } catch (error52) {
    if (error52.code === "ENOENT") return "missing";
    throw error52;
  }
}
async function fingerprintPortableContent(filePath) {
  try {
    const entry = await import_fs10.promises.lstat(filePath);
    const hash2 = (0, import_crypto2.createHash)("sha256").update(await import_fs10.promises.readFile(filePath)).digest("hex");
    return entry.isSymbolicLink() ? `symlink:${await import_fs10.promises.readlink(filePath)}:${hash2}` : `file:${hash2}`;
  } catch (error52) {
    if (error52.code === "ENOENT") return "missing";
    throw error52;
  }
}
